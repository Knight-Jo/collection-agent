\u677fIPO\u83b7\u53d7\u7406\u3002","data_html":"<p style=\"white-space: normal\"><strong>\u745e\u8d22\u7ecf \u5434\u6587\u5a77 <\/strong>6\u670816\u65e5\uff0c\u56db\u5ddd\u817e\u76fe\u79d1\u521b\u80a1\u4efd\u6709\u9650\u516c\u53f8\uff08\u4ee5\u4e0b\u7b80\u79f0\u201c\u817e\u76fe\u79d1\u521b\u201d\uff09\u521b\u4e1a\u677fIPO\u83b7\u53d7\u7406\u3002<\/p>","isEnglishStyle":0},{"type":"text","content":"\u672c\u6b21IPO\u7684\u4fdd\u8350\u673a\u6784\u4e3a\u4e2d\u56fd\u56fd\u9645\u91d1\u878d\u80a1\u4efd\u6709\u9650\u516c\u53f8\uff0c\u4fdd\u8350\u4ee3\u8868\u4eba\u4e3a\u5f90\u5a9b\u5a9b\u3001\u5f20\u5b66\u5b54\uff0c\u4f1a\u8ba1\u5e08\u4e8b\u52a1\u6240\u4e3a\u5929\u5065\u4f1a\u8ba1\u5e08\u4e8b\u52a1\u6240\uff08\u7279\u6b8a\u666e\u901a\u5408\u4f19\uff09\uff0c\u5f8b\u5e08\u4e8b\u52a1\u6240\u4e3a\u5317\u4eac\u91d1\u675c\uff08\u6210\u90fd\uff09\u5f8b\u5e08\u4e8b\u52a1\u6240\u3002","data_html":"<p style=\"white-space: normal\">\u672c\u6b21IPO\u7684\u4fdd\u8350\u673a\u6784\u4e3a\u4e2d\u56fd\u56fd\u9645\u91d1\u878d\u80a1\u4efd\u6709\u9650\u516c\u53f8\uff0c\u4fdd\u8350\u4ee3\u8868\u4eba\u4e3a\u5f90\u5a9b\u5a9b\u3001\u5f20\u5b66\u5b54\uff0c\u4f1a\u8ba1\u5e08\u4e8b\u52a1\u6240\u4e3a\u5929\u5065\u4f1a\u8ba1\u5e08\u4e8b\u52a1\u6240\uff08\u7279\u6b8a\u666e\u901a\u5408\u4f19\uff09\uff0c\u5f8b\u5e08\u4e8b\u52a1\u6240\u4e3a\u5317\u4eac\u91d1\u675c\uff08\u6210\u90fd\uff09\u5f8b\u5e08\u4e8b\u52a1\u6240\u3002<\/p>","isEnglishStyle":0},{"type":"text","content":"\u817e\u76fe\u79d1\u521b\u4e3b\u8981\u4ece\u4e8b\u9ad8\u7aef\u65e0\u4eba\u673a\u7cfb\u7edf\u7684\u7814\u53d1\u3001\u751f\u4ea7\u3001\u9500\u552e\u53ca\u76f8\u5173\u670d\u52a1\uff0c\u81f4\u529b\u4e8e\u4e3a\u56fd\u9632\u88c5\u5907\u3001\u4f4e\u7a7a\u7ecf\u6d4e\u53ca\u901a\u7528\u822a\u7a7a\u7b49\u9886\u57df\u63d0\u4f9b\u667a\u80fd\u5316\u3001\u6a21\u5757\u5316\u3001\u96c6\u7fa4\u5316\u7684\u65e0\u4eba\u673a\u7cfb\u7edf\u4ea7\u54c1\u53ca\u591a\u573a\u666f\u5e94\u7528\u7684\u6574\u4f53\u89e3\u51b3\u65b9\u6848\u3002","data_html":"<p style=\"white-space: normal\">\u817e\u76fe\u79d1\u521b\u4e3b\u8981\u4ece\u4e8b\u9ad8\u7aef\u65e0\u4eba\u673a\u7cfb\u7edf\u7684\u7814\u53d1\u3001\u751f\u4ea7\u3001\u9500\u552e\u53ca\u76f8\u5173\u670d\u52a1\uff0c\u81f4\u529b\u4e8e\u4e3a\u56fd\u9632\u88c5\u5907\u3001\u4f4e\u7a7a\u7ecf\u6d4e\u53ca\u901a\u7528\u822a\u7a7a\u7b49\u9886\u57df\u63d0\u4f9b\u667a\u80fd\u5316\u3001\u6a21\u5757\u5316\u3001\u96c6\u7fa4\u5316\u7684\u65e0\u4eba\u673a\u7cfb\u7edf\u4ea7\u54c1\u53ca\u591a\u573a\u666f\u5e94\u7528\u7684\u6574\u4f53\u89e3\u51b3\u65b9\u6848\u3002<\/p>","isEnglishStyle":0},{"type":"text","content":"\u516c\u53f8\u4ee5\u79d1\u6280\u521b\u65b0\u4e3a\u9a71\u52a8\u6784\u5efa\u4e86\u6db5\u76d6\u5927\u578b\u56fa\u5b9a\u7ffc\u65e0\u4eba\u673a\u3001\u65e0\u4eba\u76f4\u5347\u673a\u3001\u6c34\u9646\u4e24\u6816\u65e0\u4eba\u673a\u3001\u8702\u7fa4\u65e0\u4eba\u5b50\u673a\u7684\u591a\u54c1\u79cd\u4ea7\u54c1\u8c31\u7cfb\uff0c\u4ea7\u54c1\u8986\u76d6\u6ed1\u8dd1\u8d77\u964d\u3001\u5782\u76f4\u8d77\u964d\u3001\u6c34\u4e0a\u8d77\u964d\u3001\u5730\u9762\u53d1\u5c04\u3001\u7a7a\u4e2d\u6295\u653e\u7b49\u591a\u79cd\u90e8\u7f72\u65b9\u5f0f\u3002\u5176\u4e2d\uff0c\u5927\u578b\u591a\u53d1\u56fa\u5b9a\u7ffc\u65e0\u4eba\u673a\u7cfb\u5217\u662f\u516c\u53f8\u7684\u6838\u5fc3\u4ea7\u54c1\u3002\u516c\u53f8\u4ea7\u54c1\u5e7f\u6cdb\u5e94\u7528\u4e8e\u4fa6\u5bdf\u6253\u51fb\u3001\u6218\u573a\u652f\u63f4\u4fdd\u969c\u3001\u5e94\u6025\u6551\u63f4\u3001\u4eba\u5de5\u5f71\u54cd\u5929\u6c14\u3001\u7269\u6d41\u8fd0\u8f93\u7b49\u591a\u4e2a\u519b\u6c11\u5e94\u7528\u9886\u57df\u3002","data_html":"<p style=\"white-space: normal\">\u516c\u53f8\u4ee5\u79d1\u6280\u521b\u65b0\u4e3a\u9a71\u52a8\u6784\u5efa\u4e86\u6db5\u76d6\u5927\u578b\u56fa\u5b9a\u7ffc\u65e0\u4eba\u673a\u3001\u65e0\u4eba\u76f4\u5347\u673a\u3001\u6c34\u9646\u4e24\u6816\u65e0\u4eba\u673a\u3001\u8702\u7fa4\u65e0\u4eba\u5b50\u673a\u7684\u591a\u54c1\u79cd\u4ea7\u54c1\u8c31\u7cfb\uff0c\u4ea7\u54c1\u8986\u76d6\u6ed1\u8dd1\u8d77\u964d\u3001\u5782\u76f4\u8d77\u964d\u3001\u