"publish_time":617,"list_position_true":532,"id":616,"type":499,"status":53,"signed":11,"db_id":11,"scene":4,"file_name":17,"file_path":17,"file_thumb_path":17,"file_ext":17,"file_size":17,"origin_file_path":17,"origin_file_thumb_path":17,"title":618,"abstract":619,"admin_id":584,"create_time":620,"update_time":621,"delete_time":11,"source_id":4,"sign_time":11,"pv":11,"author":622,"new_date":11,"attached_list":17,"tags":623,"cover":628,"cover_h5":5,"title_image_id":629,"ad_url":5,"video_link_fb":17,"video_link_ytb":5,"video_link_tc":5,"video_link_ali":5,"video_link_other":5,"online_title":618,"online_cover":628,"online_title_image_id":629,"online_abstract":619,"nlt_title":17,"nlt_title_1":17,"nlt_abstract":17,"nlt_summary":17,"nlt_cover":17,"nlt_title_image_id":11,"not_allow_trending":11,"need_login":11,"current_admin_id":11,"media_info":17,"copy_id":11,"video_link_ali_oss":5,"cover_thumb":630,"epaper_page_id":17,"col_name":75},628066,1117489,1769689462,"HK-French joint venture to boost aircraft disassembly industry","Hong Kong’s China Aircraft Services (CASL) and France-based Elior Group on Thursday announced the establishment of a joint venture in the city dedicated to the dismantling of aircraft and trading in aircraft parts.",1769689354,1769701017,"William Xu in Hong Kong",[624,625,626,627],"Hong Kong’s China Aircraft Services (CASL)","CASL-Elior joint venture","China National Aviation Corp (Group) Ltd","International Air Transport Association","/upload/main/image/2026/01/29/a5ea40bd889b6793d7a47dff795087d7.png",1117488,"/upload/main/image/2026/01/29/a5ea40bd889b6793d7a47dff795087d7.thumb.png",{"publish_id":632,"col_id":74,"mat_id":633,"publish_time":634,"list_position_true":532,"id":633,"type":499,"status":53,"signed":11,"db_id":11,"scene":4,"file_name":17,"file_path":17,"file_thumb_path":17,"file_ext":17,"file_size":17,"origin_file_path":17,"origin_file_thumb_path":17,"title":635,"abstract":636,"admin_id":584,"create_time":637,"update_time":638,"delete_time":1