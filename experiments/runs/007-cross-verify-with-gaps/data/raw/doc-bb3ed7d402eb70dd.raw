				<div class="elementor-widget-container">
																<a href="https://bariatricsurgerymalaysia.com/">
							<img loading="lazy" width="300" height="300" src="https://bariatricsurgerymalaysia.com/wp-content/uploads/2024/01/siteicon-bariatric-surgery-malaysia-300x300.webp" class="attachment-medium size-medium wp-image-2804" alt="siteicon-bariatric-surgery-malaysia" decoding="async" srcset="https://bariatricsurgerymalaysia.com/wp-content/uploads/2024/01/siteicon-bariatric-surgery-malaysia-300x300.webp 300w, https://bariatricsurgerymalaysia.com/wp-content/uploads/2024/01/siteicon-bariatric-surgery-malaysia-150x150.webp 150w, https://bariatricsurgerymalaysia.com/wp-content/uploads/2024/01/siteicon-bariatric-surgery-malaysia.webp 512w" sizes="(max-width: 300px) 100vw, 300px" />								</a>
