<script type="application/ld+json" class="rank-math-schema-pro">{"@context":"https://schema.org","@graph":[{"@type":"Place","@id":"https://bariatricsurgerymalaysia.com/#place","geo":{"@type":"GeoCoordinates","latitude":"3.1737807328753087","longitude":" 101.69614922146212"},"hasMap":"https://www.google.com/maps/search/?api=1&amp;query=3.1737807328753087, 101.69614922146212","address":{"@type":"PostalAddress","streetAddress":"1st Mile, 109, 119, Jln Sultan Azlan Shah","addressLocality":"Titiwangsa Sentral","addressRegion":"Wilayah Persekutuan Kuala Lumpur","postalCode":"51200","addressCountry":"Malaysia"}},{"@type":["MedicalClinic","Organization"],"@id":"https://bariatricsurgerymalaysia.com/#organization","name":"Bariatric Surgery Malaysia","url":"https://bariatricsurgerymalaysia.com","sameAs":["https://www.facebook.com/bariatricsurgerymalaysia","https://www.instagram.com/bariatricsurgerymalaysia/","https://www.tiktok.com/@bariatricsurgerymy/"],"email":"malaysiabariatricsurgery@gmail.com","address":{"@type":"PostalAddress","streetAddress":"1st Mile, 109, 119, Jln Sultan Azlan Shah","addressLocality":"Titiwangsa Sentral","addressRegion":"Wilayah Persekutuan Kuala Lumpur","postalCode":"51200","addressCountry":"Malaysia"},"logo":{"@type":"ImageObject","@id":"https://bariatricsurgerymalaysia.com/#logo","url":"http://bariatricsurgerymalaysia.com/wp-content/uploads/2024/11/Bariatric-Logo-old-1.webp","contentUrl":"http://bariatricsurgerymalaysia.com/wp-content/uploads/2024/11/Bariatric-Logo-old-1.webp","caption":"Bariatric Surgery Malaysia","inLanguage":"en","width":"512","height":"512"},"priceRange":"$$$","openingHours":["Monday,Tuesday,Wednesday,Thursday,Friday 08:00-17:00","Saturday 08:00-14:00"],"description":"Bariatric Surgery Malaysia Centre in Kuala Lumpur is an MOH-certified clinic specializing in laparoscopic bariatric surgery for patients with severe obesity and Type 2 diabetes. We perform four key procedures: gastric sleeve, gastric bypass, adjustable gastric band, and duodenal switch, each tailored to your BMI, health profile, and weight loss goals. Our specialist-led team provides BMI eligibility screening for patients with BMI over 35, comprehensive pre-operative assessment, and advanced laparoscopic techniques to reduce recovery time and surgical risk.\n\nLocated in Kuala Lumpur, we deliver personalized post-operative care plans to support safe, effective weight loss and long-term metabolic health. Our clinic assists Malaysian patients with KWSP EPF medical withdrawal documentation and offers structured follow-up for diabetes remission, nutrition counseling, and sustainable weight maintenance.","location":{"@id":"https://bariatricsurgerymalaysia.com/#place"},"image":{"@id":"https://bariatricsurgerymalaysia.com/#logo"}},{"@type":"WebSite","@id":"https://bariatricsurgerymalaysia.com/#website","url":"https://bariatricsurgerymalaysia.com","name":"Bariatric Surgery Malaysia","alternateName":"Bariatric Surgery Malaysia","publisher":{"@id":"https://bariatricsurgerymalaysia.com/#organization"},"inLanguage":"en"},{"@type":"ImageObject","@id":"https://bariatricsurgerymalaysia.com/wp-content/uploads/2026/06/buah-pinggang.webp","url":"https://bariatricsurgerymalaysia.com/wp-content/uploads/2026/06/buah-pinggang.webp","width":"200","height":"200","inLanguage":"en"},{"@type":"BreadcrumbList","@id":"https://bariatricsurgerymalaysia.com/blog/buah-pinggang/#breadcrumb","itemListElement":[{"@type":"ListItem","position":"1","item":{"@id":"https://bariatricsurgerymalaysia.com","name":"Home"}},{"@type":"ListItem","position":"2","item":{"@id":"https://bariatricsurgerymalaysia.com/category/blog/","name":"Blog"}},{"@type":"ListItem","position":"3","item":{"@id":"https://bariatricsurgerymalaysia.com/blog/buah-pinggang/","name":"Buah Pinggang Rosak: Tanda Awal, Punca dan 5 Peringkat Kegagalan"}}]},{"@type":"WebPage","@id":"https://bariatricsurgerymalaysia.com/blog/buah-pinggang/#webpage","url":"https://bariatricsurgerymalaysia.com/blog/buah-pinggang/","name":"Buah Pinggang Rosak: Tanda Awal, Punca &amp; 5 Peringkat CKD","datePublished":"2026-06-16T15:00:09+08:00","dateModified":"2026-07-31T13:17:26+08:00","isPartOf":{"@id":"https://bariatricsurgerymalaysia.com/#website"},"primaryImageOfPage":{"@id":"https://bariatricsurgerymalaysia.com/wp-content/uploads/2026/06/buah-pinggang.webp"},"inLanguage":"en","breadcrumb":{"@id":"https://bariatricsurgerymalaysia.com/blog/buah-pinggang/#breadcrumb"}},{"@type":"Person","@id":"https://bariatricsurgerymalaysia.com/author/bariatricoperation-my/","name":"Dr. Navin Mann","url":"https://bariatricsurgerymalaysia.com/author/bariatricoperation-my/","image":{"@type":"ImageObject","@id":"https://secure.gravatar.com/avatar/8cfcda9a06dbf8d64e8d45546c145209b85b656cf0506ab230efff53c2d2ad33?s=96&amp;d=mm&amp;r=g","url":"https://secure.gravatar.com/avatar/8cfcda9a06dbf8d64e8d45546c145209b85b656cf0506ab230efff53c2d2ad33?s=96&amp;d=mm&amp;r=g","caption":"Dr. Navin Mann","inLanguage":"en"},"sameAs":["https://bariatricsurgerymalaysia.com"],"worksFor":{"@id":"https://bariatricsurgerymalaysia.com/#organization"}},{"@type":"BlogPosting","headline":"Buah Pinggang Rosak: Tanda Awal, Punca &amp; 5 Peringkat CKD","keywords":"Buah Pinggang","datePublished":"2026-06-16T15:00:09+08:00","dateModified":"2026-07-31T13:17:26+08:00","articleSection":"Blog","author":{"@id":"https://bariatricsurgerymalaysia.com/author/bariatricoperation-my/","name":"Dr. Navin Mann"},"publisher":{"@id":"https://bariatricsurgerymalaysia.com/#organization"},"description":"Buah pinggang rosak ialah keadaan apabila keupayaan buah pinggang untuk menapis sisa dan cecair berlebihan daripada darah semakin terjejas. Ia boleh berlaku","name":"Buah Pinggang Rosak: Tanda Awal, Punca &amp; 5 Peringkat CKD","@id":"https://bariatricsurgerymalaysia.com/blog/buah-pinggang/#richSnippet","isPartOf":{"@id":"https://bariatricsurgerymalaysia.com/blog/buah-pinggang/#webpage"},"image":{"@id":"https://bariatricsurgerymalaysia.com/wp-content/uploa