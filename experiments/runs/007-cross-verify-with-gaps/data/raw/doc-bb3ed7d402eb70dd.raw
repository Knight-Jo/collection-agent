				<div class="elementor-element elementor-element-5681a12 elementor-widget elementor-widget-html" data-id="5681a12" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<div class="dr-profile-card"><div class="dr-profile-inner"><div class="dr-profile-image-wrapper"><img src="https://bariatricsurgerymalaysia.com/wp-content/uploads/2024/11/bariatric-surgery-navin.webp" alt="Dr. Navin Mann"></div><div class="dr-profile-content"><div class="dr-profile-subtitle">Specialist Surgeon</div><div class="dr-profile-name"><a href="https://bariatricsurgerymalaysia.com/doctors/dr-navin-mann-profile/">Dr. Navin Mann</a></div><p class="dr-profile-bio">Dr Navin Mann is a Consultant Bariatric, Metabolic & General Surgeon in Malaysia with expertise in bariatric surgery, metabolic surgery, laparoscopic (keyhole) surgery, hernia surgery, gallbladder surgery, thyroid surgery, hemorrhoid surgery, gastrointestinal (GI) cancer surgery, and breast surgery. Registered with the National Specialist Register (NSR) Malaysia, he provides evidence-based surgical care focused on obesity management, metabolic health improvement, and minimally invasive treatment approaches. His articles are reviewed for medical accuracy and are intended to support patient education and informed healthcare decisions.</p><div class="dr-profile-action"><a href="https://bariatricsurgerymalaysia.com/doctors/dr-navin-mann-profile/" class="dr-profile-btn">View Full Profile</a></div></div></div></div><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');.dr-profile-card{--espresso:#341A00;--white:#ffffff;--transition:all .45s cubic-bezier(.23,1,.32,1);font-family:Inter,sans-serif;width:100%;margin:0!important;padding:0;box-sizing:border-box}.dr-profile-card *,.dr-profile-card *::before,.dr-profile-card *::after{box-sizing:inherit}.dr-profile-inner{background:var(--white);padding:40px;border:1px solid rgba(52,26,0,.12);border-radius:40px;display:flex;flex-direction:column;align-items:flex-start;text-align:left;transition:var(--transition)}.dr-profile-card:hover .dr-profile-inner{border-color:var(--espresso);box-shadow:0 25px 50px rgba(52,26,0,.06);transform:translateY(-4px)}.dr-profile-image-wrapper{margin-bottom:30px;line-height:0;align-self:center}.dr-profile-image-wrapper img{width:160px;height:160px;object-fit:cover;border-radius:50%;border:1px solid var(--espresso);padding:5px;transition:var(--transition)}.dr-profile-card:hover .dr-profile-image-wrapper img{transform:scale(1.04)}.dr-profile-content{width:100%;max-width:680px}.dr-profile-subtitle{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:3px;color:var(--espresso);opacity:.5;margin-bottom:10px}.dr-profile-name{font-size:26px;font-weight:700;margin:0 0 16px 0;letter-spacing:-.8px}.dr-profile-name a{text-decoration:none;color:var(--espresso);transition:color .3s ease}.dr-profile-bio{font-size:15.5px;line-height:1.8;color:var(--espresso);opacity:.8;margin:0 0 30px 0}.dr-profile-action{display:flex;justify-content:flex-start}.dr-profile-btn{display:inline-block;background-color:var(--espresso);color:var(--white)!important;padding:12px 40px;border-radius:50px;font-size:14px;font-weight:600;text-decoration:none!important;border:2px solid var(--espresso);transition:var(--transition)}.dr-profile-btn:hover{background-color:transparent;color:var(--espresso)!important;transform:translateY(-2px)}@media (max-width:600px){.dr-profile-inner{padding:40px 24px;border-radius:24px}.dr-profile-name{font-size:24px}.dr-profile-bio{font-size:14.5px;line-height:1.7}}</style>				</div>
