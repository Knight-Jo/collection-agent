<style>
    :root {
        --brand-orange: #D95F02; /* Warm Brown-Orange Theme */
    }

    #cta-hub-container.cta-force-reset {
        position: fixed !important;
        bottom: 30px !important;
        right: 30px !important;
        z-index: 999999 !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 15px !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .cta-button {
        position: relative !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 60px !important;
        height: 60px !important;
        border-radius: 50% !important;
        backdrop-filter: blur(10px) !important;
        -webkit-backdrop-filter: blur(10px) !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
        text-decoration: none !important;
        background-color: rgba(217, 95, 2, 0.1) !important; /* Orange glass */
        border: 1px solid rgba(217, 95, 2, 0.2) !important;
    }

    .cta-icon-svg {
        height: auto !important;
        fill: var(--brand-orange) !important;
        transition: transform 0.3s ease, fill 0.3s ease !important;
    }

    .call-btn .cta-icon-svg { width: 24px !important; }
    .wa-btn .cta-icon-svg { width: 30px !important; }

    .wa-dot {
        position: absolute !important;
        top: 2px !important;
        right: 2px !important;
        width: 12px !important;
        height: 12px !important;
        background-color: var(--brand-orange) !important;
        border: 2px solid white !important;
        border-radius: 50% !important;
    }

    .cta-button:hover {
        transform: scale(1.1) translateY(-3px) !important;
        background-color: var(--brand-orange) !important;
        box-shadow: 0 15px 30px rgba(217, 95, 2, 0.4) !important;
    }

    .cta-button:hover .cta-icon-svg {
        fill: #ffffff !important;
    }

    @media (max-width: 767px) {
        #cta-hub-container.cta-force-reset {
            bottom: 20px !important;
            right: 20px !important;
            gap: 12px !important;
        }
        .cta-button {
            width: 54px !important;
            height: 54px !important;
        }
    }
</style>

<script type="text/rocketlazyloadscript">
    (function() {
        window.addEventListener('load', function() {
            const hub = document.querySelector('#cta-hub-container');
            if(hub) {
                hub.style.opacity = '0';
                hub.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    hub.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
                    hub.style.opacity = '1';
                    hub.style.transform = 'translateY(0)';
                }, 1000);
            }
        });
    })();
</script>				</div>
