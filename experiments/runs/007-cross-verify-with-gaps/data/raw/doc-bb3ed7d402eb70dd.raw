<style id="jeg_dynamic_css" type="text/css" data-type="jeg_custom-css"></style><style id="wp-custom-css">
/* Import Inter SemiBold (for headings) */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@600&display=swap');

/* BODY: Apple System UI font */
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.7;
  font-weight: 400;
  color: #2e2e2e;
  background: #fff;
  margin: 0;
  padding: 0;
}

/* PARAGRAPHS */
p {
  margin-bottom: 1.2em;
  line-height: 1.7;
}

/* HEADINGS: Inter SemiBold */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  font-weight: 600;
  line-height: 1.2;
  margin-top: 1.1em;
  margin-bottom: 0.4em;
  letter-spacing: -0.01em;
  color: #181A20;
}
h1 { font-size: 2.2rem; }
h2 { font-size: 1.65rem; }
h3 { font-size: 1.35rem; }
h4 { font-size: 1.13rem; }
h5 { font-size: 1.02rem; }
h6 { font-size: 1rem; }

/* LISTS */
ul, ol { padding-left: 1.3em; margin-bottom: 1.1em; }
li { margin-bottom: 0.4em; }

/* CODE */
code, pre {
  font-family: 'SFMono-Regular', 'Courier New', Courier, monospace;
  background: #f5f5f5;
  padding: 0.17em 0.38em;
  border-radius: 4px;
  font-size: 95%;
}

/* BLOCKQUOTE */
blockquote {
  border-left: 3px solid #e0e0e0;
  padding-left: 1em;
  color: #555;
  margin: 1em 0;
  font-style: italic;
  background: #fcfcfc;
}

/* SPACING UTILITIES */
.spacing-md { margin-bottom: 1.4em; }
.spacing-lg { margin-bottom: 2.6em; }

/* ELEMENTOR-FRIENDLY: No global or aggressive resets */

/* RESPONSIVE */
@media (max-width: 768px) {
  body { font-size: 15px; }
  h1 { font-size: 1.45rem; }
  h2 { font-size: 1.2rem; }
  h3 { font-size: 1.08rem; }
  h4, h5, h6 { font-size: 1rem; }
}

</style>
