Data Protection Officer: <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="4e2a3e2160232f222f373d272f0e262b2222212a21253a213c602d2123">[email&#160;protected]</a></div></div></div></div></div></footer></div></div><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"page":"article","articles":[{"ID":194514,"post_name":"punca-buah-pinggang-rosak","post_title":"Buah Pinggang Rosak? Ini 4 Penyakit Utama Yang Menyebabkan Ginjal Tak Dapat Berfungsi!","post_status":"publish","post_date":"2021-08-17 20:00:24","post_date_utc":"2021-08-17 12:00:24","post_modified":"2025-03-02 15:24:39","post_modified_utc":"2025-03-02 07:24:39","modified_time":"02/03/2025","edit_last":{"ID":156,"user_id":156,"former_role":"","role":"editor","slug":"mdwaiz","display_name":"Muhammad Wa'iz","description":"","profile_url":"/author/mdwaiz/","avatar":"https://cdn.hellodoktor.com/wp-content/uploads/2025/09/c2636372-kai_8626-300x200.jpg","avatar_thumbnail":"https://cdn.hellodoktor.com/wp-content/uploads/2025/09/c2636372-kai_8626-150x150.jpg","avatar_large":"https://cdn.hellodoktor.com/wp-content/uploads/2025/09/c2636372-kai_8626-1024x682.jpg","turn_off_profile":false},"permalink":"/urologi/penyakit-buah-pinggang/punca-buah-pinggang-rosak/","permalink_decode":"/urologi/penyakit-buah-pinggang/punca-buah-pinggang-rosak/","label":"explainer","is_sponsored":false,"is_premium":false,"reviewed":{"author":{"ID":193,"user_id":193,"former_role":"","role":"editor","slug":"fatin","display_name":"Fatin Zahra","description":"","profile_url":"/author/fatin/","avatar":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Picture_NurFatin-200x300.jpg","avatar_thumbnail":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Picture_NurFatin-150x150.jpg","avatar_large":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Picture_NurFatin-683x1024.jpg","turn_off_profile":false},"editor":null,"expert":{"ID":174,"user_id":174,"former_role":"","role":"medical","slug":"dr-joseph-tan","display_name":"Dr. Joseph Tan","description":"","profile_url":"/expert/dr-joseph-tan/","avatar":"https://cdn.hellodoktor.com/wp-content/uploads/2019/07/Picture1-300x300.jpg","avatar_thumbnail":"https://cdn.hellodoktor.com/wp-content/uploads/2019/07/Picture1-150x150.jpg","avatar_large":"https://cdn.hellodoktor.com/wp-content/uploads/2019/07/Picture1.jpg","turn_off_profile":false,"care-booking":null,"specialty":"Perubatan dalaman atau am","organisation":"Hello Health Group","organisation_url":""},"fact_check":{"ID":120,"user_id":120,"former_role":"","role":"medical","slug":"hdmedicalteam","display_name":"Panel Perubatan Hello Doktor","description":"","profile_url":"/expert/hdmedicalteam/","avatar":"https://cdn.hellodoktor.com/assets/avatar-default.png","avatar_thumbnail":"https://cdn.hellodoktor.com/assets/avatar-default.png","avatar_large":"https://cdn.hellodoktor.com/assets/avatar-default.png","turn_off_profile":false,"care-booking":null,"specialty":"","organisation":"","organisation_url":""},"is_author":false},"pregnancy":false,"week_pregnancy":0,"post_content":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBuah pinggang merupakan salah satu organ badan yang sangat penting. Antara punca buah pinggang rosak yang lazim ialah kecederaan fizikal atau penyakit seperti penyakit diabetes dan tekanan darah tinggi.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cimg data-feature-img alt=\"Buah Pinggang Rosak? Ini 4 Penyakit Utama Yang Menyebabkan Ginjal Tak Dapat Berfungsi!\" fetchpriority=\"high\" decoding=\"async\" data-nimg=\"fill\" sizes=\"(max-width: 768px) 100vw, (max-width: 1170px) 60vw, 700px\" srcset=\"https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=384\u0026amp;q=100 384w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=640\u0026amp;q=100 640w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=750\u0026amp;q=100 750w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=828\u0026amp;q=100 828w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=1080\u0026amp;q=100 1080w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=1200\u0026amp;q=100 1200w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=1920\u0026amp;q=100 1920w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=2048\u0026amp;q=100 2048w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=3840\u0026amp;q=100 3840w\" src=\"https://cdn.hellodoktor.com/wp-content/uploads/2021/08/6c859c6b-young-girl-s-back-hurts.jpg?w=3840\u0026amp;q=100\" style=\"position: absolute; height: 100%; width: 100%; inset: 0px; object-fit: cover; color: transparent;\" \u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBuah pinggang dikatakan rosak apabila 85% hingga 90% fungsinya telah hilang. Pada waktu ini, buah pinggang tidak dapat lagi menjalankan tugasnya dengan baik.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-5-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eNamun, tanda kerosakan buah pinggang sukar untuk dikenal pasti. Disebabkan organ ini mempunyai daya tahan yang tinggi, \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/urologi/penyakit-buah-pinggang/kegagalan-buah-pinggang/\" href=\"https://hellodoktor.com/urologi/penyakit-buah-pinggang/kegagalan-buah-pinggang/\"\u003esimptom hanya akan mulai muncul apabila buah pinggang sudahpun rosak.\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"after-3rd-paragraph\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSebarang kerosakan pada buah pinggang tidak berlaku dalam masa sehari. Malah, organ ini hanya akan rosak setelah bertahun-tahun bertahan dengan gaya hidup yang tidak sihat.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eOleh sebab itu, tidak hairanlah ramai pesakit buah pinggang hanya akan merasai simptom ketika penyakit ini sudah menjadi serius.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-10-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTetapi, apakah punca buah pinggang rosak? Mari ikuti penjelasan kami di dalam artikel di bawah.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"after-6th-paragraph\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003ch2 data-tableid=\"punca-buah-pinggang-rosak\" \u003e\u003cb\u003ePunca buah pinggang rosak\u003c/b\u003e\u003c/h2\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-15-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eAda banyak perkara yang boleh menyebabkan kerosakan buah pinggang. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eAntara penyebabnya ialah pengaliran darah yang terbatas, kerosakan pada \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/pemakanan/fakta-nutrisi/kebaikan-makanan-organik/\" href=\"https://hellodoktor.com/pemakanan/fakta-nutrisi/kebaikan-makanan-organik/\" target=\"_blank\" rel=\"noopener\"\u003eorgan\u003c/a\u003e tersebut atau wujudnya \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/urologi/batu-karang/tanda-sakit-batu-karang-buah-pinggang/\" href=\"https://hellodoktor.com/urologi/batu-karang/tanda-sakit-batu-karang-buah-pinggang/\"\u003ehalangan pada saluran urinari.\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-20-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eNamun, ada beberapa kondisi atau penyakit yang boleh menjadi punca buah pinggang rosak\u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003e. Antaranya ialah:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003ch3 data-tableid=\"1-tekanan-darah-tinggi\" \u003e\u003cb\u003e1. \u003c/b\u003e\u003cb\u003eTekanan darah tinggi\u003c/b\u003e\u003c/h3\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"continue-reading-articles\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-25-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cfigure id=\"attachment_194518\" aria-describedby=\"caption-attachment-194518\" style=\"width: 600px\" class=\"wp-caption aligncenter\"\u003e\u003cimg loading=\"lazy\" class=\"wp-image-194518 size-full\" src=\"https://cdn.hellodoktor.com/wp-content/uploads/2021/08/eb3cc33a-anonymous-doctor-measuring-blood-pressure-unrecognizable-patient-with-tonometer.jpg\" alt=\"Pemeriksaan tekanan darah tinggi. \" width=\"600\" height=\"400\" srcset=\"https://cdn.hellodoktor.com/wp-content/uploads/2021/08/eb3cc33a-anonymous-doctor-measuring-blood-pressure-unrecognizable-patient-with-tonometer.jpg 600w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/eb3cc33a-anonymous-doctor-measuring-blood-pressure-unrecognizable-patient-with-tonometer-300x200.jpg 300w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/eb3cc33a-anonymous-doctor-measuring-blood-pressure-unrecognizable-patient-with-tonometer-90x60.jpg 90w\" sizes=\"(max-width: 600px) 100vw, 600px\" /\u003e\u003cfigcaption id=\"caption-attachment-194518\" class=\"wp-caption-text\"\u003ePemeriksaan tekanan darah tinggi.\u003c/figcaption\u003e\u003c/figure\u003e\n\u003cp\u003e\u003cdiv class=\"after-10th-paragraph\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTahukah anda, buah pinggang dan saluran darah kita sebenarnya saling bergantung antara satu sama lain? Bahan buangan dari darah dikumuhkan dari badan dengan bantuan buah pinggang.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eNamun, untuk menjalankan tugas ini, buah pinggang memerlukan banyak saluran darah. Apabila saluran darah ini rosak atau tercedera, penapis kecil yang terletak pada buah pinggang \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/urologi/masalah-urologi/jenis-penyakit/\" href=\"https://hellodoktor.com/urologi/masalah-urologi/jenis-penyakit/\"\u003etidak dapat berfungsi dengan baik.\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eInilah sebabnya mengapa tekanan darah tinggi merupakan antara punca buah pinggang rosak yang utama.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eLama-kelamaan, tekanan darah tinggi boleh menyebabkan saluran darah di sekeliling buah pinggang untuk menyempit dan mengeras.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eAkibatnya, buah pinggang akan jadi semakin lemah kerana salur darah di sekelilingnya \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/urologi/penyakit-buah-pinggang/cara-nak-sembuhkan-sakit-buah-pinggang/\" href=\"https://hellodoktor.com/urologi/penyakit-buah-pinggang/cara-nak-sembuhkan-sakit-buah-pinggang/\" target=\"_blank\" rel=\"noopener\"\u003erosak\u003c/a\u003e secara perlahan-lahan.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eBukan itu sahaja, buah pinggang juga mempunyai tugas yang tersendiri dalam mengekalkan tekanan darah seseorang. Jika ia rosak, badan akan menghadapi kesukaran untuk mengekalkan tekanan darah dalam paras yang normal.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-40-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003ch3 data-tableid=\"2-penyakit-diabetes-boleh-menyebabkan-buah-pinggang-rosak\" \u003e\u003cb\u003e2. Penyakit d\u003c/b\u003e\u003cb\u003eiabetes boleh menyebabkan buah pinggang rosak\u003c/b\u003e\u003c/h3\u003e\n\u003c/p\u003e\n\u003cfigure id=\"attachment_194521\" aria-describedby=\"caption-attachment-194521\" style=\"width: 600px\" class=\"wp-caption aligncenter\"\u003e\u003cimg loading=\"lazy\" class=\"wp-image-194521 size-full\" src=\"https://cdn.hellodoktor.com/wp-content/uploads/2021/08/df297f7b-woman-making-blood-sugar-test-home-diabetic-measures-level-glucose-blood-diabetes-concept.jpg\" alt=\"Semak gula darah anda. \" width=\"600\" height=\"400\" srcset=\"https://cdn.hellodoktor.com/wp-content/uploads/2021/08/df297f7b-woman-making-blood-sugar-test-home-diabetic-measures-level-glucose-blood-diabetes-concept.jpg 600w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/df297f7b-woman-making-blood-sugar-test-home-diabetic-measures-level-glucose-blood-diabetes-concept-300x200.jpg 300w, https://cdn.hellodoktor.com/wp-content/uploads/2021/08/df297f7b-woman-making-blood-sugar-test-home-diabetic-measures-level-glucose-blood-diabetes-concept-90x60.jpg 90w\" sizes=\"(max-width: 600px) 100vw, 600px\" /\u003e\u003cfigcaption id=\"caption-attachment-194521\" class=\"wp-caption-text\"\u003eSemak gula darah anda.\u003c/figcaption\u003e\u003c/figure\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003ePenyakit diabetes berlaku apabila badan anda \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/kencing-manis/diabetes-jenis-dua/kesan-diabetes-pada-jantung/\" href=\"https://hellodoktor.com/kencing-manis/diabetes-jenis-dua/kesan-diabetes-pada-jantung/\"\u003etidak dapat membuat atau menggunakan hormon insulin yang mencukupi.\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSalah satu fungsi insulin adalah mengawal jumlah gula dalam darah. Tanpa hormon ini, sukar untuk tubuh mengawal kadar gula dalam badan. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003e Tahap gula yang tinggi di dalam badan boleh mencetuskan pelbagai masalah pada jantung, buah pinggang, mata dan otak. Lama-kelamaan, perkara ini juga boleh \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/pemakanan/tips-lain/minum-air-laut/\" href=\"https://hellodoktor.com/pemakanan/tips-lain/minum-air-laut/\"\u003emenyebabkan kerosakan pada buah pinggang.\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-50-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eApabila penyakit diabetes tidak dikawal, tahap gula dalam darah akan meningkat naik. Kondisi ini \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/kencing-manis/komplikasi-diabetes/apakah-itu-hiperglisemia/\" href=\"https://hellodoktor.com/kencing-manis/komplikasi-diabetes/apakah-itu-hiperglisemia/\"\u003edikenali sebagai hiperglisemia\u003c/a\u003e dan boleh merosakkan banyak bahagian badan.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSama seperti \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/penyakit-jantung/tekanan-darah/simptom-tekanan-darah-tinggi/\" href=\"https://hellodoktor.com/penyakit-jantung/tekanan-darah/simptom-tekanan-darah-tinggi/\"\u003etekanan darah tinggi\u003c/a\u003e, penyakit diabetes juga boleh merosakkan saluran darah dan saraf pada kawasan buah pinggang. Tanpa bekalan darah yang mencukupi, buah pinggang akan rosak dan \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/urologi/masalah-urologi/jenis-penyakit/\" href=\"https://hellodoktor.com/urologi/masalah-urologi/jenis-penyakit/\"\u003etidak dapat berfungsi dengan baik.\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003ch3 data-tableid=\"3-kegagalan-jantung-dan-kegagalan-buah-pinggang\" \u003e\u003cb\u003e3. \u003c/b\u003e\u003cb\u003eKegagalan jantung dan kegagalan buah pinggang\u003c/b\u003e\u003c/h3\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTahukah anda, \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/penyakit-jantung/sakit-jantung/sakit-dada-bahagian-tengah/\" href=\"https://hellodoktor.com/penyakit-jantung/sakit-jantung/sakit-dada-bahagian-tengah/\"\u003epenyakit jantung\u003c/a\u003e boleh menyebabkan masalah buah pinggang? Malah, \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/penyakit-jantung/sakit-jantung/sakit-dada-bahagian-tengah/\" href=\"https://hellodoktor.com/penyakit-jantung/sakit-jantung/sakit-dada-bahagian-tengah/\"\u003epenyakit jantung\u003c/a\u003e juga merupakan antara punca kematian yang lazim dalam kalangan \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/urologi/penyakit-buah-pinggang/apa-itu-dialisis-rawatan/\" href=\"https://hellodoktor.com/urologi/penyakit-buah-pinggang/apa-itu-dialisis-rawatan/\"\u003eindividu yang sedang menjalani dialisis.\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-59-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eApabila jantung mengalami kegagalan, buah pinggang juga boleh mendapat kemerosotan dari segi fungsi. Bukan itu sahaja, sakit jantung juga boleh menyebabkan penyakit buah pinggang kronik.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-60-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eTetapi, bagaimanakah perkara ini berlaku? Penghidap penyakit jantung tidak dapat mengepam darah dengan cara yang betul. Akibatnya, jantung pesakit akan dipenuhi dengan darah.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003ePada masa yang sama, salur darah utama yang menuju ke buah pinggang akan mengalami peningkatan tekanan. Tekanan ini akan menyebabkan salur darah tersumbat dan mengurangkan bekalan darah kepada buah pinggang.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003ch3 data-tableid=\"4-penyakit-kanser\" \u003e\u003cb\u003e4. \u003c/b\u003e\u003cb\u003ePenyakit kanser\u003c/b\u003e\u003c/h3\u003e\n\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKanser juga boleh menjadi punca kerosakan buah pinggang, salah satunya \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/kanser/kanser-lain/kanser-buah-pinggang/\" href=\"https://hellodoktor.com/kanser/kanser-lain/kanser-buah-pinggang/\"\u003eialah kanser buah pinggang.\u003c/a\u003e Sama seperti kebanyakan kanser yang lain, penghidap kanser ini mungkin tidak akan mengalami sebarang tanda atau simptom awal.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eMalah, kanser buah pinggang juga selalunya ditemui secara tidak sengaja ketika pesakit melakukan imbasan pada kawasan perut disebabkan masalah kesihatan lain.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKajian menunjukkan ada kaitan di antara kanser buah pinggang dan penyakit buah pinggang. \u003c/span\u003e\u003cspan style=\"font-weight: 400;\"\u003eMalah, mereka yang mengalami kerosakan buah pinggang juga didapati berisiko untuk menghidap kanser disebabkan dialisis yang berpanjangan dan pengambilan ubat-ubatan.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003ch2 data-tableid=\"kesimpulan\" \u003e\u003cstrong\u003eKesimpulan\u003c/strong\u003e\u003c/h2\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-80-of-article\"\u003e\u003c/div\u003e\n\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSebenarnya, ada banyak lagi punca buah pinggang rosak yang tidak digariskan di dalam artikel ini.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSebagai contoh, darah beku atau kolesterol pada kawasan buah pinggang, \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/urologi/masalah-urologi/penyakit-glomerulonephritis/\" href=\"https://hellodoktor.com/urologi/masalah-urologi/penyakit-glomerulonephritis/\"\u003epenyakit glomerulonephritis\u003c/a\u003e, jangkitan, ubat-ubatan dan juga \u003ca data-event-category=\"Internal Link Click on Article\" data-event-action=\"click\" data-event-label=\"https://hellodoktor.com/kesihatan/fakta-menarik/penyakit-lupus-bahaya/\" href=\"https://hellodoktor.com/kesihatan/fakta-menarik/penyakit-lupus-bahaya/\"\u003epenyakit imun seperti Lupus\u003c/a\u003e juga boleh menjadi punca buah pinggang rosak.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eKegagalan buah pinggang sukar untuk dikesan awal atau dicegah. Namun, dengan penjagaan yang betul, risiko kerosakan buah pinggang dapat dikurangkan.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eSebagai contoh, pastikan anda peka dengan ubat-ubatan yang diambil untuk mengawal kesakitan. Ubat tahan sakit ini jika diambil dengan terlalu banyak boleh menyebabkan kerosakan buah pinggang.\u003c/span\u003e\u003c/p\u003e\n\u003cdiv class=\"unique-content\"\u003e\u003cdiv class=\"insert-content-container content-key-takeaways\"\u003e\u003cdiv class=\"content\"\u003e\n\u003cspan style=\"font-weight: 400;\"\u003eAkhir sekali, pastikan anda bekerjasama dengan doktor untuk mengawal masalah buah pinggang yang dialami. \u003c/span\u003e\u003cbr/\u003e\n\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eJangan lupa makan ubat terutamanya jika anda menghidap penyakit seperti diabetes dan tekanan darah tinggi.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cp\u003e[embed-health-tool-bmi]\u003c/p\u003e \u003cp\u003e\u003cdiv data-embed-type=\"subot\" data-id=\"251\"\u003e\u003c/div\u003e\u003c/p\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"percentages-100-of-article\"\u003e\u003c/div\u003e\u003c/p\u003e\n","sources":"\u003col\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eAmerican Heart Association. 2016. \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003eHow High Blood Pressure Can Lead to Kidney Damage or Failure.\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e October 31. Accessed August 5, 2021. https://www.heart.org/en/health-topics/high-blood-pressure/health-threats-from-high-blood-pressure/how-high-blood-pressure-can-lead-to-kidney-damage-or-failure.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eAmerican Kidney Fund. n.d. \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003eHeart disease \u0026amp; chronic kidney disease (CKD).\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e Accessed August 5, 2021. https://www.kidneyfund.org/kidney-disease/chronic-kidney-disease-ckd/complications/heart-disease/#heart-disease-ckd-connection.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eLifeOptions. n.d. \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003e15 Symptoms of Kidney Disease.\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e Accessed August 5, 2021. https://lifeoptions.org/learn-about-kidney-disease/kidney-disease-symptoms/.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eMayo Clinic. 2020. \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003eAcute kidney failure.\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e July 23. Accessed August 5, 2021. https://www.mayoclinic.org/diseases-conditions/kidney-failure/symptoms-causes/syc-20369048.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNational Kidney Foundation. n.d. \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003eWhat is Kidney Failure?\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e Accessed August 5, 2021. https://www.kidney.org/atoz/content/KidneyFailure.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNational Kidney Foundation. 2014. \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003eDiabetes and Kidney Disease (Stages 1-4).\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e December 17. Accessed August 5, 2021. https://www.kidney.org/atoz/content/Diabetes-and-Kidney-Disease-Stages1-4.\u003c/span\u003e\u003c/li\u003e\n\u003cli style=\"font-weight: 400;\"\u003e\u003cspan style=\"font-weight: 400;\"\u003eNational Kidney Foundation. n.d. \u003c/span\u003e\u003ci\u003e\u003cspan style=\"font-weight: 400;\"\u003eKidney Cancer.\u003c/span\u003e\u003c/i\u003e\u003cspan style=\"font-weight: 400;\"\u003e Accessed August 5, 2021. https://www.kidney.org/atoz/content/kidney-cancer.\u003c/span\u003e\u003c/li\u003e\n\u003c/ol\u003e\n","categories":[{"termId":142922,"name":"Penyakit Buah Pinggang","iconUrl":"","displayName":"Penyakit Buah Pinggang","permalink":"/urologi/penyakit-buah-pinggang/","permalinkDecode":"/urologi/penyakit-buah-pinggang/","slug":"penyakit-buah-pinggang","childCates":[],"textColor":"#2d87f3","catParent":{},"metaTag":"","reviewedDate":"","translateOptions":[],"suggestionTools":[],"mastheadAdPlacement":{"enableDesktop":false,"enableMobile":false}}],"breadcrumb":[{"catName":"Urologi","image":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Urological-Health.png","name":"Urologi","permalink":"/urologi/","termId":142603,"enName":"Urological Health","icon":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Urological-Health.png","imageColor":"#e3f2ff","textColor":"#2d87f3"},{"catName":"Penyakit Buah Pinggang","image":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Kidney-Disease.png","name":"Penyakit Buah Pinggang","permalink":"/urologi/penyakit-buah-pinggang/","termId":142922,"enName":"Kidney Disease","icon":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Kidney-Disease.png","imageColor":"#e3f2ff","textColor":"#2d87f3"}],"primary_category":{"term_id":142922,"slug":"penyakit-buah-pinggang","count":59,"name":"Penyakit Buah Pinggang","permalink":"/urologi/penyakit-buah-pinggang/","permalink_decode":"/urologi/penyakit-buah-pinggang/","text_color":"#2d87f3","image":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Kidney-Disease.png","icon":"https://cdn.hellodoktor.com/wp-content/uploads/2021/03/Kidney-Disease.png","lang":"ms"},"ima