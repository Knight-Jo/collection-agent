	require([
		'plugins_nav_custom_nav_header',
	], function(
		headerNav,
	) {
		const root = document.querySelector('[data-guid="13c4891b-0f30-4b67-baa9-35e950f95bf9"][data-initialized="false"]');
		if (root) {
			const translations = JSON.parse(document.querySelector('[data-translations="13c4891b-0f30-4b67-baa9-35e950f95bf9"]').innerHTML);
			const navDepth = 3;
	
			const mainNav = root.closest('[data-main-nav]');
			const secondaryNav = root.closest('[data-secondary-nav]');
	
			if (mainNav) {
				const mainMenu = mainNav.closest('[data-main-menu]');
				headerNav.init({
					root: mainMenu,
					selector: '[data-main-nav]',
					depth: navDepth,
					translations,
				});
			}
	
			if (secondaryNav) {
				const panelHeader = secondaryNav.closest('[data-panel-header]');
				headerNav.init({
					root: panelHeader,
					selector: '[data-secondary-nav]',
					depth: navDepth,
					translations,
				});
			}

			root.setAttribute('data-initialized', 'true');
		}
	});
</script>
