		<script>
			let pageTitleTag = document.querySelector('title');
			let path = window.location.pathname;
			let isListing = /^\/listing\/(?:[^\/]+)\/\d+\//.test(path);
			let isOffer = /^\/offer\/(?:[^\/]+)\/\d+\//.test(path);
			if (pageTitleTag && (isListing || isOffer)) {
				pageTitleTag.classList?.add('notranslate');
			}
		</script>
		
