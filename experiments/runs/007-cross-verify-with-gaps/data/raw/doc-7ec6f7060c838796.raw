<script>
	// For gtranslate to run, there can't be dependencies or domReady!
	// So this script tag is split up into two require blocks
	require([], function () {
		window.gtranslateSettings = {
			default_language: 'en',
		};

		// Find out if the nav item is translated
		const translatedCmsString = document.querySelector('[data-global-translation-info]').innerHTML;
		const translatedCms = JSON.parse(translatedCmsString || {}).translated;
		
		const panelPage = document.querySelector('[data-panel-page]');

		// See if there is a google translate cookie already
		const gtcookie = String(readCookie('googtrans')).match(/\/[A-Za-z_0-9\-]+\/([A-Za-z_0-9\-]+)/);

		// Gets the language code of the current page
		let languageCode = "en";

		// The language of the page pretranslation
		const pageLanguage = translatedCms ? languageCode : 'en';

		// The page is untranslated and with what we know so far, will need to be translated
		let needToTranslate = !translatedCms && languageCode !== 'en';

		// DETAIL PAGE LOGIC //
		// Find out if we are on a detail page and if it is translated
		const isDetailPage = /\/(listing|event|offer)[\-\/]/.test(window.location.pathname);
		const detailPageUntranslated = isDetailPage
			? !JSON.parse(document.querySelector('[data-detail-translated]')?.innerHTML || "true")
			: false;
		
		
		if (isDetailPage && (needToTranslate ^ detailPageUntranslated)) {
			const detailSection = panelPage.querySelector('[data-detail-container]');

			// If the page is marked as translated in the cms, but the detail widget needs to be translated
			if (!needToTranslate) {
				panelPage.classList.add('notranslate');
				detailSection.classList.add('translate');
				needToTranslate = true;
			}

			// If the page is not marked as translated in the cms, but the detail page should not be translated
			if (!detailPageUntranslated) {
				detailSection.classList.add('notranslate');
			}
		}

		// BLOG DETAIL LOGIC //
		// Find out if we are on a blog detail page and if we came from a non english site
		const isBlogDetail = /\/post\//.test(window.location.pathname);
		const referrerLanguage = document.referrer.match(/https:\/\/(es|spanish|pt|portuguese|fr|french|de|german)/);

		const siteToLanguageCode = {
			es: 'es',
			spanish: 'es',
			pt: 'pt',
			portuguese: 'pt',
			fr: 'fr',
			french: 'fr',
			de: 'de',
			german: 'de',
		}

		if (isBlogDetail && pageLanguage === 'en' && referrerLanguage) {
			// Translate the blog els
			const blogEls = document.querySelectorAll('[data-blog-detail-hero], [data-sv-blog-container]');

			// Do not translate these, because clicking any of these items will go to english pages
			const untranslatedEls  = [
				panelPage,
				...Array.from(document.querySelectorAll('.related-container, [data-sibling-posts-container]'))
			];
			
			untranslatedEls.forEach(el => {
				if (!el) return;
				el.classList.add('notranslate');
			});
			blogEls.forEach(el => el.classList.add('translate'));

			// We have to reset these, since we are translating on an english page
			languageCode = siteToLanguageCode[referrerLanguage[1]];
			needToTranslate = true;
		}

		// If there is already a cookie in the correct language, we may not need to reset it
		const needNewCookie = Array.isArray(gtcookie) && gtcookie[1] !== languageCode;

		// Delete old cookie if needed
		if (needNewCookie || languageCode === 'en' || !needToTranslate) {
			deleteCookie('googtrans');
		}

		// Add new cookie if needed
		if (needToTranslate && (!gtcookie || needNewCookie)) {
			document.cookie = `googtrans=/en/${languageCode};path=/`;
		};

		function readCookie(name) {
			let nameEQ = name + "=";
			let ca = document.cookie.split(';');
			for (let i = 0; i < ca.length; i++) {
				let c = ca[i];
				while (c.charAt(0)==' ') c = c.substring(1, c.length);
				if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
			}
			return null;
		}

		function deleteCookie(name) {
			let delCookie = name + '=;expires=Thu, 01 Jan 1970 00:00:01 GMT;path=/';
			document.cookie = delCookie;
			document.cookie = delCookie + '; domain=' + window.location.host;
			document.cookie = delCookie + '; domain=' + window.location.hostname.split('.').slice(-2).join('.');
		}
	});

	// This block needs to be run after domReady!
	require(["plugins_core/main", "sv_site", "domReady!"], function(core, { site }) {
		// DOM Elements
		const root = document.querySelector('[data-guid="9679c570-c040-4f2d-bc24-8032c389721b"]');
		const dropdownToggle = root.querySelector('[data-dropdown-toggle]');
		const dropdownOptions = root.querySelector('[data-dropdown-options]');
		const overlay = root.querySelector('[data-overlay]');

		// Widget data
		const locales = [{"config":{"code":"en-ca","cmsLabel":"English - Canada","label":"English","countryCode":"ca"},"selected":false},{"config":{"code":"en-gb","cmsLabel":"English - Great Britain","label":"English","countryCode":"gb"},"selected":false},{"config":{"code":"en-ie","cmsLabel":"English - Ireland","label":"English","countryCode":"ie"},"selected":false},{"config":{"code":"en-us","label":"English","cmsLabel":"English - US","countryCode":"us"},"selected":true,"href":"https://www.visitorlando.com/things-to-do/theme-parks/"},{"config":{"code":"fr-ca","cmsLabel":"French - Canada","label":"French","countryCode":"ca"},"selected":false},{"config":{"code":"fr-fr","cmsLabel":"French - France","label":"French","countryCode":"fr"},"selected":false},{"config":{"code":"de-de","cmsLabel":"German - Germany","label":"German","countryCode":"de"},"selected":false,"href":"https://de.visitorlando.com/aktivitaeten/themenparks/"},{"config":{"code":"pt-br","cmsLabel":"Portuguese - Brazil","label":"Portuguese","countryCode":"br"},"selected":false,"href":"https://pt.visitorlando.com/atividades/parques-tematicos/"},{"config":{"code":"es-cl","cmsLabel":"Spanish - Chile","label":"Spanish","countryCode":"cl"},"selected":false},{"config":{"code":"es-co","cmsLabel":"Spanish - Colombia","label":"Spanish","countryCode":"co"},"selected":false},{"config":{"code":"es","cmsLabel":"Spanish - ES","label":"Spanish","countryCode":"es"},"selected":false,"href":"https://es.visitorlando.com/actividades/parques-tematicos/"},{"config":{"code":"es-419","cmsLabel":"Spanish - Latin America","label":"Spanish","countryCode":"419"},"selected":false},{"config":{"code":"es-mx","cmsLabel":"Spanish - Mexico","label":"Spanish","countryCode":"mx"},"selected":false},{"config":{"code":"es-pe","cmsLabel":"Spanish - Peru","label":"Spanish","countryCode":"pe"},"selected":false}];

		const detailRegex = /\/(listing|event|offer)[\-\/]/;
		const isDetail = detailRegex.test(window.location.pathname);

		let abortController;

		const codeToLocaleObjMap = {};

		const languages = locales.reduce((acc, locale) => {
			// This tells us if there is no matching page for a locale
			const code = locale.config?.code?.split('-')[0];
			const label = locale.config?.label;
			if (code && label) codeToLocaleObjMap[code] = { code, label };
			if (!locale.href) return acc;
			return [...acc, { ...locale, code, label }];
		}, []);

		const siteToLocaleObjMap = {
			default: codeToLocaleObjMap.en,
			spanish: codeToLocaleObjMap.es,
			french: codeToLocaleObjMap.fr,
			portuguese: codeToLocaleObjMap.pt,
			german: codeToLocaleObjMap.de,
		};
		
		// Handle when there are no locales linked to the page
		if (!languages.length) {
			languages.push(
				siteToLocaleObjMap[site] || siteToLocaleObjMap.default
			);
		}
			
		let languageCode = "en";
		languageCode ||= siteToLocaleObjMap?.[site]?.code || 'en';
			
		// Create dropdown toggle
		dropdownToggle.prepend(languageCode);

		const html = languages.map(language => {
			return (`
				<button
					data-code=${language.code}
					${language.href ? `data-href=${language.href}` : ''}
					tabindex="-1"
					class="option notranslate"
				>
					${language.label}
				</button>
			`)
		}).join('\n');

		dropdownOptions.insertAdjacentHTML('beforeend', html);

		// What happens when you click a new language in toggle
		dropdownOptions.addEventListener('click', handleLocaleChange);

		[dropdownToggle, overlay].forEach(el => el.addEventListener('click', toggleMenu));

		function handleLocaleChange (e) {
			const button = e.target.closest('button');
			if (!button) return;
			if (!dropdownOptions.contains(button)) return;

			const lang = button.dataset.code;

			if (!lang || lang.toLowerCase() === languageCode.toLowerCase()) return;
			
			dropdownOptions.querySelectorAll('.option').forEach(option => {
				option.classList.remove('active');
			});

			button.classList.add('active');

			let href = button.dataset.href;

			// Delay page navigation by 100ms to show the visual change (highlight) before the new page loads
			setTimeout(() => {
				if (isDetail) {
					// This gets the list of related listings from `widget_detail`
					const locale_related = JSON.parse(document.querySelector('[data-detail-locale-related]')?.innerHTML || "[]");
	
					// Find out if the site you are going to has a related listing
					const relatedLocale = locale_related.find(
						({ locale_code }) => locale_code.slice(0,2) === lang.slice(0, 2)
					)
	
					// If there is a related listing, use the recid to get the url
					if (locale_related.length && relatedLocale) {
						if (abortController) {
							abortController.abort();
						}
	
						abortController = new AbortController();
	
						const xhr = new URL(
							`${window.location.protocol}//${window.location.host}/includes/rest_v2/plugins_listings_listings/find/`
						);
	
						xhr.searchParams.append('json', JSON.stringify({
							filter : { recid: relatedLocale.recid },
							options : { fields: { url: 1 } }
						}));
	
						xhr.searchParams.append('token', core.simpleToken );
						const fetchOptions = {
							method: 'GET',
							mode: 'no-cors',
							signal: abortController.signal,
						};
	
						fetch(xhr, fetchOptions)
							.then(function(res) { return res.json() })
							.then(function(res) {
								if (res?.docs?.length && res.docs[0]?.url) {
									// Go to the page of the related listing url
									window.location.href = href + res.docs[0].url.replace(detailRegex, '');
								}
							})
							.catch(function(err) {
								if (err.name === "AbortError") {
									return;
								}
								console.log(err);
							})
						return;
					}
	
					// If there is not a related listing, we just go to the same listing on the target language site
					href += window.location.pathname.replace(detailRegex, '');
				}
	
				// Go to the new page
				window.location.href = href;
			}, 100);
		}

		function toggleMenu() {
			root.classList.toggle('open');
			const open = root.classList.contains('open');

			if (open) {
				dropdownToggle.setAttribute('aria-expanded', true);
			} else {
				dropdownToggle.removeAttribute('aria-expanded');
			}

			dropdownOptions.querySelectorAll('buttons').forEach(button => {
				if (open) {
					button.removeAttribute('tabindex');
					button.removeAttribute('aria-hidden');
					return;
				}

				button.setAttribute('tabindex', -1);
				button.setAttribute('aria-hidden', true);
			});
		}
	});
</script></div>
		</div>

