			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Universal Orlando has four parks, including a water theme park. They include <a href='https://www.visitorlando.com/things-to-do/theme-parks/universal-orlando-resort/universal-studios-florida/'>Universal&#xA0;Studios Florida</a>, <a href='https://www.visitorlando.com/things-to-do/theme-parks/universal-orlando-resort/islands-of-adventure/'>Universal Islands of Adventure</a>, <a href='https://www.visitorlando.com/things-to-do/theme-parks/universal-orlando-resort/volcano-bay/'>Universal Volcano Bay</a> and the all-new&#xA0;<a href='https://www.visitorlando.com/things-to-do/theme-parks/universal-orlando-resort/epic-universe/'>Universal Epic Universe</a>. You can also opt for dinner, entertainment, shopping and more at <a href='https://www.visitorlando.com/things-to-do/theme-parks/universal-orlando-resort/citywalk/'>Universal CityWalk</a>, located at the nexus of Universal Orlando, or an amazing stay at one&#xA0;of <a href='https://www.visitorlando.com/places-to-stay/hotels-resorts/universal-all-listings/'>Universal Orlando&#x2019;s official hotel properties and other nearby accommodations</a>.&#xA0;"
				
			}
		},
	
		{
			"@type": "Question",
			"name": "How many theme parks are at SeaWorld&reg; Orlando?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "For up-close animal encounters and pulse-pounding rides, <a href='https://www.visitorlando.com/things-to-do/theme-parks/seaworld-orlando/seaworld/'>SeaWorld&#x2019;s main Orlando&#xA0;theme park</a> has you covered. You can also take advantage of sandy beaches and thrilling&#xA0;rides at <a href='https://www.visitorlando.com/things-to-do/theme-parks/seaworld-orlando/aquatica/'>Aquatica&#xAE; Orlando</a>, or enjoy serene relaxation, awe-inspiring animal encounters&#xA0;and perfect pampering at <a href='https://www.visitorlando.com/things-to-do/theme-parks/seaworld-orlando/discovery-cove/'>Discovery Cove</a>&#xAE; (<a href='https://discoverycove.com/orlando/pricing/'>reservations required</a>). SeaWorld is also an&#xA0;official partner of <a href='https://www.visitorlando.com/places-to-stay/hotels-resorts/?bounds=false&amp;filter_regions%5B0%5D=173&amp;sort=qualityScore&amp;view=grid'>several nearby hotels</a>, which provide guests with special park benefits."
				
			}
		},
	
		{
			"@type": "Question",
			"name": "How many theme parks are at LEGOLAND&reg; Florida Resort?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Children and their families can have a blast with kids-focused rides and plenty of building opportunities at LEGOLAND Florida Resort. In addition to <a href='https://www.visitorlando.com/things-to-do/theme-parks/legoland-florida-resort/legoland-florida-theme-park/'>LEGOLAND&#xAE; Florida Theme Park</a> and its onsite <a href='https://www.visitorlando.com/listing/legoland%c2%ae-water-park/51906/'>LEGOLAND&#xAE; Florida Water Park</a>, LEGOLAND Florida operates <a href='https://www.visitorlando.com/things-to-do/theme-parks/legoland-florida-resort/peppa-pig-theme-park/'>Peppa Pig Theme Park Florida</a> and SEA LIFE Florida Aquarium."
				
			}
		}
	
	]
}
</script>
<script>
	window.addEventListener("load", function(){
		// Merges schema if more than one widget on page. Must fire on page load to avoid errors in Google Search Console
		var schemaBlock = document.querySelectorAll("[data-sv-faqschema]");
		if(schemaBlock[0].dataset.merged === "true"){
			return;
		}
		var parentBlock, parentBlockMainEntity;
		var additionalSchema = [];
		schemaBlock.forEach(block => {
			if(schemaBlock[0] === block){
				parentBlock = block;
				parentBlockMainEntity = JSON.parse(parentBlock.innerHTML);
			}else{
				var markup = JSON.parse(block.innerHTML)["mainEntity"]
				parentBlockMainEntity.mainEntity.push(...markup);
				block.parentNode.removeChild(block);
			}
		});
		parentBlockMainEntity = JSON.stringify(parentBlockMainEntity);
		parentBlock.innerHTML = parentBlockMainEntity;
		parentBlock.setAttribute("data-merged", "true");
	});

	require(['plugins_common_custom_utils', 'domReady!'], function(utils) {
		const root = document.querySelector('[data-guid="4bb62d57-9dcc-4758-8f8d-735734ef0d0b"]');
		const childTabs = Array.from(root.querySelectorAll('[data-accordion] [data-accordion-item]'));
		const faqTabContent = root.querySelector('[data-tab-content]');
		const faqTabCs = faqTabContent ? getComputedStyle(faqTabContent) : null;
		const drawerTransitionDuration = parseFloat(faqTabCs && faqTabCs.getPropertyValue('transition-duration')) * 1000;
		const resizeEvents = ['resize', 'orientationchange'];
		const focusableQuery = 'a, area, button, input, object, select, textarea, [tabindex]';

		function open(el) {
			const parent = el.parentElement;
			const panel = parent.querySelector('[data-tab-content]');
			const maxHeight = `${panel.scrollHeight}px`;

			parent.classList.add('active');

			el.setAttribute('open', true);
			el.setAttribute('aria-expanded', true);

			panel.setAttribute('aria-hidden', false);
			panel.style.maxHeight = maxHeight;
			panel.querySelectorAll(focusableQuery).forEach(el => el.setAttribute('tabindex', 0))
		}

		function close(el) {
			const parent = el.parentElement;
			const panel = parent.querySelector('[data-tab-content]');

			parent.classList.remove('active');

			el.removeAttribute('open');
			el.setAttribute('aria-expanded', false);

			panel.setAttribute('aria-hidden', true);
			panel.style.maxHeight = '';
			panel.querySelectorAll(focusableQuery).forEach(el => el.setAttribute('tabindex', -1));
		}

		function resizeFn() {
			const openTabs = childTabs.filter(tab => tab.classList.contains('active'));

			if (!openTabs || !openTabs.length) return;

			openTabs.forEach(tab => {
				const tabContent = tab.querySelector('[data-tab-content]');

				tabContent.style.maxHeight = `${tabContent.scrollHeight}px`;
			});
		}

		
		// -- INIT -- //

		root.querySelectorAll(`[data-tab-content] :is(${focusableQuery}`).forEach(el => el.setAttribute('tabindex', -1))
		root.querySelectorAll('[data-accordion-item] [data-accordion-title]').forEach(node => node.addEventListener('click', () => {
			if (node.parentElement.classList.contains('active')) {
				close(node);
			} else {
				open(node);
			}
		}));

		// when resizing the window, make sure the open accordions don't allow the content to overflow
		resizeEvents.forEach(ev => window.addEventListener(ev, utils.debounce(resizeFn, 200)));
	});
</script></div><div data-civid="65f86484c7a4884cb6316e06" class="contentRender contentRender_24 contentRender_type_panel contentRender_name_plugins_common_custom_combo" data-sv-time="1" data-sv-index="24" data-gtm-vars='{ "tCore" : { "contentNum" : "5" } }'>



