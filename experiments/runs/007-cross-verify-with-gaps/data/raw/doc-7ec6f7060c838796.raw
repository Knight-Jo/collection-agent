<script>
	require([
		'plugins_common_custom_utils',
		'plugins_nav_custom_nav_header',
	], function(
		utils,
		headerNav,
	) {
		const root = document.querySelector('[data-guid="a9fb0651-c3f9-4c2e-9e32-39ad48ddb645"]');
		const mainMenu = document.querySelector('[data-main-menu="a9fb0651-c3f9-4c2e-9e32-39ad48ddb645"]');
		const els = {
			ariaHide: Array.from(document.querySelectorAll('[data-aria-hide]')),
			closeMenuButton: mainMenu.querySelector('[data-action="close-menu"]'),
			headerContainer: document.querySelector('[data-header-container]'),
			openMenuButton: root.querySelector('[data-action="open-menu"]'),
			page: document.querySelector('[data-panel-page]'),
			secondaryNav: root.querySelector('[data-secondary-nav]'),
		};
		const cssClasses = {
			active: 'active',
			in: 'in',
			out: 'out',
		};
		const translations = JSON.parse(document.querySelector('[data-translations="a9fb0651-c3f9-4c2e-9e32-39ad48ddb645"]').innerHTML);
		const focusables = 'a, button, input, select, textarea, iframe, area, details, progress';
		const navDepth = 3;
		const animationDuration = 300; // milliseconds
		let headerHeight = 0;
		let timeout;
		let secondaryTimeout;

		function resizeHandler() {
			const containerHeight = els.headerContainer.offsetHeight;
			const secondaryDropdownOuters = Array.from(els.secondaryNav.querySelectorAll('[data-dropdown-outer]'));

			if (containerHeight === headerHeight) return;

			// add padding to top of body on resize
			els.page.style.paddingTop = `${containerHeight}px`;

			// set secondary dropdown max-heights on resize
			if (secondaryDropdownOuters.length) {
				secondaryDropdownOuters.forEach(dd => dd.style.maxHeight = `calc(100vh - ${containerHeight}px)`);
			}

			headerHeight = containerHeight;
		}

		function openMainMenu() {
			mainMenu.classList.add(cssClasses.in);
			mainMenu.classList.remove(cssClasses.out);

			if (timeout) clearTimeout(timeout);

			timeout = setTimeout(() => {
				mainMenu.classList.add(cssClasses.active);
				mainMenu.classList.remove(cssClasses.in);
			}, animationDuration);

			document.body.classList.add('menu-open');

			// accessibility
			els.ariaHide.forEach(el => {
				const focus = Array.from(el.querySelectorAll(focusables));
				const index = el.getAttribute('tabindex') || false;

				el.setAttribute('aria-hidden', true);
				el.setAttribute('tabindex', -1);
				if (index) el.setAttribute('data-tabindex', index);

				focus.forEach(f => {
					const fIndex = f.getAttribute('tabindex') || false;

					f.setAttribute('tabindex', -1);
					if (fIndex) f.setAttribute('data-tabindex', fIndex);
				});
			});
		}
		
		function closeMainMenu() {
			mainMenu.classList.add(cssClasses.out);
			mainMenu.classList.remove(cssClasses.in, cssClasses.active);

			if (timeout) clearTimeout(timeout);

			timeout = setTimeout(() => {
				mainMenu.classList.remove(cssClasses.out);
			}, animationDuration);

			document.body.classList.remove('menu-open');

			// accessibility
			els.ariaHide.forEach(el => {
				const focus = Array.from(el.querySelectorAll(focusables));
				const index = el.getAttribute('data-tabindex') || false;

				el.removeAttribute('aria-hidden');
				el.removeAttribute('tabindex');
				if (index) el.setAttribute('tabindex', index);

				focus.forEach(f => {
					const fIndex = f.getAttribute('data-tabindex') || false;

					f.removeAttribute('tabindex');
					if (fIndex) f.setAttribute('tabindex', fIndex);
				});
			});
		}

		function bindEventListeners() {
			['resize', 'orientationchange'].forEach(ev => window.addEventListener(ev, utils.debounce(resizeHandler, 200)));

			// open and close main menu
			els.openMenuButton.addEventListener('click', openMainMenu);
			els.closeMenuButton.addEventListener('click', closeMainMenu);
		}

		function init() {
			resizeHandler();
			bindEventListeners();
		}

		init();
	});
</script></div>
	</div>
