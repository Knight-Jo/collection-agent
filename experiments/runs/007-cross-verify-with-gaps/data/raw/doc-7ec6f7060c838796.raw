	// This script is for resizing the Mosaic Grid text links so that the underline hover animation does not exceed the width of the largest line of text //
	if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
		var contentLink = document.querySelectorAll('.content-link'), i, w, width, height;

		for (i = 0; i < contentLink.length; i++) {
			const width = contentLink[i].offsetWidth;
			const height = contentLink[i].offsetHeight;

			for (w = width; w; w--) {
				contentLink[i].style.width = w + 'px';
				if (contentLink[i].offsetHeight !== height) break;
			}

			if (w < contentLink[i].scrollWidth) {
				contentLink[i].style.width = contentLink[i].style.maxWidth = contentLink[i].scrollWidth + 'px';
			} else {
				contentLink[i].style.width = (w + 1) + 'px';
			}
		}
	}
</script>
