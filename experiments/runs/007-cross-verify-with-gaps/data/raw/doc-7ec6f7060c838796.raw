		<nav
			class="navigation navigation-three-col primary"
			role="navigation"
			data-primary-nav
			
	data-gtm-vars='{"tClient_ga4": {"eventName": "navigation_click", "navType": "Main", "interactionSource": "navigation"}}'

		>
			<script type="text/template" data-nav-item-template>{{~exec(function() {
	helpers.var = {
		...helpers.var,
		...data.var,
	};
})}}

{{+linkTracking}}
	data-gtm-click data-gtm-vars='{"tClient_ga4" : {"eventName" : "navigation_click", "linkObject": "{{%data.title}}", "interactionSource": "navigation", "interactionUrl": "{{%%href}}", "interactionText": "{{%%data.title}}"}}'
{{/}}

{{+image_card}}
	{{~exec(function() {
		helpers.var.link = data.data.link || {
			url: data.data.href,
			target: data.data.target || '_self'
		};
		data.data.image = data.data.image || {
			resource: helpers.plugins.cloudinary.createResource({
				imageUrl: helpers.plugins.sv_site.siteConfig.custom[helpers.plugins.sv_site.site].defaultImageUrl
			})
		};
	})}}
	
	<a
		class="image-card"
		href="{{~var.link.url}}"
		target="{{~var.link.target}}"
		aria-label="{{data.title}}{{:~var.link}}{{:~equal(helpers.var.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
		title="{{data.title}}"
		data-gtm-click data-gtm-vars='{"tClient_ga4" : {"eventName" : "navigation_click", "linkObject": "{{%%data.title}}", "interactionSource": "navigation", "interactionUrl": "{{%%~var.link.url}}", "interactionText": "{{%%data.title}}"}}'
	>
		<h2 class="card-title">{{data.title}}</h2>
		<img
			class="card-background"
			aria-hidden="true"
			alt=""
			src="{{data.image.resource.getThumbnailUrl({
				crop: 'fill',
				quality: 65,
				sv: { gravity: 'focalPoint' },
				fetch_format: 'jpg',
				width: 640,
				height: 433,
			})}}"
			loading="lazy"
			fetchpriority="low"
		>
	</a>
{{/}}

{{+nav_items}}
	{{+nav_items_helper}} {{!-- This nested partial is necessary to make this partial recursive because helpers.partial 
		only outputs the inner text of the partial, not the partial name. Please do not remove! --}}

		{{#shownChildren}}
			{{~exec(function() {
				if (!data.isLazyLoaded) {
					helpers.var.depth = 1;
				} else {
					helpers.var.depth = data.depth;
				}

				helpers.var.hasDropdown = !!(data.shownChildren && data.shownChildren.length) || !!(data.data.custom_image_card && data.data.custom_image_card.length && helpers.var.depth === 1);
				helpers.var.hasCardsOnly = (!data.shownChildren || (!!data.shownChildren && !data.shownChildren.length)) && !!data.data.custom_image_card && !!data.data.custom_image_card.length && helpers.var.depth === 1;
				helpers.var.level1ParentNavHref = (helpers.var.depth === 1 && data.href) ? data.href : '';
			})}}
			
			<div class="nav-item level-{{~var.depth}} {{data.section}}" data-id="{{data.id}}" data-nav-item data-level="{{~var.depth}}">
				<div class="nav-item-control level-{{~var.depth}} notranslate">
					{{:~var.hasDropdown}}
						<a
							class="nav-link level-{{~var.depth}}"
							{{:~var.level1ParentNavHref}} href="{{~var.level1ParentNavHref}}"{{/}}
							target="{{target}}"
							aria-label="{{data.title}}{{:target}}{{:~equal(data.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
							data-nav-link
							data-dropdown-toggle
							{{>linkTracking}}
						>
							{{data.title}}
							<span class="underline"></span>
						</a>
						<button
							class="dropdown-toggle level-{{~var.depth}}"
							aria-label="open submenu"
							aria-haspopup="true"
							aria-expanded="false"
							data-dropdown-toggle
						></button>
					{{?}}
						<a
							class="nav-link level-{{~var.depth}}"
							href="{{href}}"
							target="{{target}}"
							aria-label="{{data.title}}{{:target}}{{:~equal(data.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
							data-nav-link
							{{>linkTracking}}
						>
							{{data.title}}
						</a>
					{{/}}
				</div>
				{{:~var.hasDropdown}}
				<div class="dropdown-helper" data-dropdown-helper aria-hidden="true"></div>
					{{:~equal(helpers.var.depth == 1, true)}}
						<div class="dropdown-overlay" data-dropdown-overlay></div>
						<div class="dropdown-outer{{:~var.hasCardsOnly}} no-nav-items{{/}}" data-dropdown-outer>
							<div class="back-button-row">
								<button
									class="button-default back-button notranslate"
									aria-label="back button"
									data-close-dropdowns
								>
									{{~var.translations.close_dropdown}}
								</button>
							</div>
	
							<div class="dropdown-scroll styled-scrollbar">
					{{/}}
					<div
						class="dropdown-menu level-{{~var.depth}}
							{{:isLazyLoaded}}
								{{:shownChildren.0}}rendered{{/}}
							{{/}}"
						aria-labelledby="{{data.id}}"
						data-parent-id="{{data.id}}"
						data-start="{{data.folderHref}}"
						data-section="{{data.section}}"
						data-dropdown-menu
						data-level="{{~var.depth}}"
						style="z-index: {{~exec(helpers.var.depth + 1)}}"
					>
						<div class="dropdown-inner" data-dropdown-inner>
							{{:~equal(helpers.var.depth == 1, true)}}
							<div class="dropdown-top-row">
								<a
									id="{{data.id}}"
									class="top-link notranslate"
									href="{{href}}"
									target="{{target}}"
									aria-label="{{data.title}}{{:target}}{{:~equal(data.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
								>
									{{data.title}} {{~var.translations.overview}}
								</a>
							</div>
							{{/}}

							{{:~equal(helpers.var.depth > 1, true)}}
								<div class="dropdown-top-row">
									<button 
										class="dropdown-back-button"
										aria-label="back button"
										data-dropdown-back
									>
										<span class="button-text notranslate">
											{{~var.translations.back}}
										</span>
									</button>
	
									<a
										class="top-link notranslate"
										href="{{href}}"
										target="{{target}}"
										aria-label="{{data.title}}{{:target}}{{:~equal(data.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
									>
										{{data.title}} {{~var.translations.overview}}
									</a>
								</div>
							{{/}}

							<div class="dropdown-grid" data-dropdown-grid>
								{{:~equal(!!data.isLazyLoaded && !!data.shownChildren && !!data.shownChildren.length, true)}}
									{{>nav_items_helper}}
								{{/}}
							</div>
						</div>
					</div>
					{{:~equal(helpers.var.depth == 1, true)}}
								<div class="image-cards">
									{{>image_card}}

									{{:data.custom_image_card.length}}
										{{:shownChildren}}
											{{~fill(helpers.partial('image_card'), {
												data: data.data.custom_image_card[0],
											})}}
										{{?}}
											{{#data.custom_image_card.slice(0, 3)}}
												{{~fill(helpers.partial('image_card'), {
													data,
												})}}
											{{/}}
										{{/}}
									{{/}}
								</div>
							</div>
						</div>
					{{/}}
				{{/}}
			</div>
		{{/}}
	{{/}}
	{{>nav_items_helper}}
{{/}}

{{>nav_items}}</script>
			








	
	 

		
			
			
