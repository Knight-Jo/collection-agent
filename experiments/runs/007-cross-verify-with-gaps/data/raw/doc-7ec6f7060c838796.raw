  <script type="text/template" data-slide-template>
  <div class="inner" data-gtm-vars='{ "tClient_ga4" : { "interactionSource" : "widget"{{:itemCategory}}, "itemCategory" : "{{%%itemCategory}}"{{/}}{{:itemSubcategory}}, "itemSubcategory" : "{{%%itemSubcategory}}"{{/}}{{:city}}, "itemCity" : "{{%%city}}"{{?:listings}}, "itemCity" : "{{%%listings.0.city}}"{{/}}{{:region}}, "itemRegion" : "{{%%region}}"{{?:listings}}, "itemRegion" : "{{%%listings.0.region}}"{{/}}{{:recid}}, "itemId" : "{{%%recid}}"{{/}}{{:accountId}}, "acctId" : "{{%%accountId}}"{{?:acctid}}, "acctId" : "{{%%acctid}}"{{/}}{{:~equal(data.featuredItem && data.featuredItem === true, true)}}, "featuredItem" : true{{?:~equal(data.featuredItem === undefined, false)}}, "featuredItem" : false{{/}}{{:memberInfo}}, "memberInfo" : "{{%%memberInfo}}"{{/}} } }'>

    {{~setVar('isMindtrip', () => typeof data.link_or_mindtrip === 'string' && data.link_or_mindtrip.includes('mindtrip'))}}

    
    <div class="card-wrapper" data-asset role="group" aria-label="{{title}}">
      <div class="slide-top">
        {{:~var.isBlog}}
          {{~fill(helpers.partial('custom_ccl/extras/blog_feed_header'), data)}}
        {{/}}

        <div class="img-cont img-zoom">
          
          {{:~var.isMindtrip}}
            {{:isDTN}}
              {{~fill(helpers.partial('custom_responsive_image'), {
                asset: data.asset,
                config: helpers.var.sponsoredConfig,
                useLazyLoading: false
              })}}
            {{?}}
              {{~fill(helpers.partial('custom_responsive_image'), {
                asset: data.asset,
                config: helpers.var.config
              })}}
            {{/}}
          {{?}}
            <a
              data-asset
              href="{{assetLink()}}"
              target="{{link.target}}"
              aria-label="{{title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
              data-gtm-click
              data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "{{:isVideo()}}Video Click{{?}}Image{{/}}", "itemName" : "{{%%title}}", "interactionUrl" : "{{assetLink()}}" } }'
            >
              {{:isDTN}}
                {{~fill(helpers.partial('custom_responsive_image'), {
                  asset: data.asset,
                  config: helpers.var.sponsoredConfig,
                  useLazyLoading: false
                })}}
              {{?}}
                {{~fill(helpers.partial('custom_responsive_image'), {
                  asset: data.asset,
                  config: helpers.var.config
                })}}
              {{/}}
            </a>
          {{/}}

          {{~fill(helpers.partial('custom_asset_credits'), data.asset)}}
          {{:isVideo()}}
            <span class="play-overlay" aria-hidden="true" style="pointer-events: none;">
              {{>custom_play_button}}
            </span>
          {{/}}
          {{:nextDate}}
            {{~fill(helpers.partial('custom_ccl/extras/mini_date'), data)}}
          {{/}}
          {{:isDTN}}
            {{~fill(helpers.partial('custom_ccl/extras/sponsored'), helpers.var.config)}}
          {{/}}
        </div>
      </div>

      <div class="content-section">
        <div class="inner">
          {{:isDTN}}
            {{~fill(helpers.partial('custom_ccl/extras/sponsored'), helpers.var.config)}}
          {{/}}

          
          <h{{~var.slideHeading}} class="slide-title">
            {{:~var.isMindtrip}}
              <span
                aria-label="{{title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
                data-gtm-click
                data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Title", "itemName" : "{{%%title}}", "interactionUrl" : "{{%%link.url}}", "interactionText" : "{{%%title}}" } }'
              >
                {{title}}
              </span>
            {{?}}
              <a
                href="{{link.url}}"
                target="{{link.target}}"
                aria-label="{{title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
                data-gtm-click
                data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Title", "itemName" : "{{%%title}}", "interactionUrl" : "{{%%link.url}}", "interactionText" : "{{%%title}}" } }'
              >
                {{title}}
              </a>
            {{/}}
          </h{{~var.slideHeading}}>

          {{:hasDeets()}}
            <ul class="details">
              {{:~var.isBlog}}
                {{:timeToRead}}
                  <li class="info-item">
                    <i aria-hidden="true" class="icon fas fa-clock"></i><span>{{timeToRead.minutes}} {{timeToRead.label}}</span>
                  </li>
                {{/}}
              {{/}}

              {{:~var.isListing}}
                {{:address}}
                  <li class="info-item">
                    <i aria-hidden="true" class="icon fas fa-map-marker-alt"></i><span>{{address}}</span>
                  </li>
                {{/}}

                {{:phone}}
                  <li class="info-item">
                    <i aria-hidden="true" class="icon fas fa-phone-alt"></i><span>{{phone}}</span>
                  </li>
                {{/}}
              {{/}}

              {{:~var.isEvent}}
                {{:venue}}
                  <li class="info-item has-link">
                    <a
                      href="{{venue.url}}"
                      target="{{link.target}}"
                      aria-label="{{venue.title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
                      data-gtm-click
                      data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Link to Venue", "itemName" : "{{%%venue.title}}", "itemType" : "listings" {{:venue.primary_category}}, "itemCategory" : "{{%%venue.primary_category.catname}}"{{/}}{{:venue.primary_category}}, "itemSubcategory" : "{{%%venue.primary_category.subcatname}}"{{/}}, "interactionText" : "{{%%venue.title}}", "interactionUrl" : "{{%%venue.url}}"{{:venue.region}}, "itemRegion" : "{{%%venue.region}}"{{/}}{{:venue.city}}, "itemCity" : "{{%%venue.city}}"{{/}}{{:venue.recid}}, "itemId" : "{{%%venue.recid}}"{{/}}{{:venue.acctid}}, "acctId" : "{{%%venue.acctid}}"{{/}}{{:~equal(data.venue.rankname && data.venue.rankname === "Featured", true)}}, "featuredItem" : true{{?}}, "featuredItem" : false{{/}}{{:venue.memberInfo}}, "memberInfo" : "{{%%venue.memberInfo}}"{{/}} } }'
                    >
                      <i aria-hidden="true" class="icon fas fa-map-marker-alt"></i>
                      <span>{{venue.title}}</span>
                    </a>
                  </li>
                {{/}}

                {{:recurrence}}
                  <li class="info-item">
                    <i aria-hidden="true" class="icon fas fa-calendar-week"></i><span>{{recurrence}}</span>
                  </li>
                {{/}}
              {{/}}

              {{:~var.isOffer}}
                {{:listings}}
                  <li class="info-item">
                    <i aria-hidden="true" class="icon fas fa-map-marker-alt"></i>
                    <div class="inline-list">
                      {{#listings}}
                        <a
                          href="{{url}}"
                          target="{{link.target}}"
                          aria-label="{{title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
                          data-gtm-click
                          data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Link to Venue", "itemName" : "{{%%title}}", "itemType" : "listings", "itemCategory" : "{{%%primary_category.catname}}", "itemSubcategory" : "{{%%primary_category.subcatname}}", "interactionText" : "{{%%title}}", "interactionUrl" : "{{%%url}}", "itemRegion" : "{{%%region}}", "itemCity" : "{{%%city}}", "itemId" : "{{%%recid}}", "acctId" : "{{%%acctid}}"{{:~equal(data.rankname && data.rankname === "Featured", true)}}, "featuredItem" : true{{?}}, "featuredItem" : false{{/}}{{:memberInfo}}, "memberInfo" : "{{%%memberInfo}}"{{/}} } }'
                        >
                          {{title}}
                        </a>
                        {{!@last}}
                          <span>,</span>
                        {{/last}}
                      {{/}}
                    </div>
                  </li>
                {{/}}

                <li class="info-item">
                  <i aria-hidden="true" class="icon fas fa-calendar-week"></i><span>{{formattedDate()}}</span>
                </li>
              {{/}}
            </ul>
          {{/}}

          {{:description}}<p>{{plainDescription(helpers.var.config.descriptionTruncation)}}</p>{{/}}
        </div>

        
        <footer class="slide-footer" data-gtm-vars='{ "tClient_ga4" : { "itemName" : "{{%%title}}" } }'>
          {{:~var.coreLib.handleMindtripOrStandardLinkShow({
            data,
            numberOf: 1,
            widgetButtonTextFallback: helpers.var.widgetMoreCaption
          })}}
            {{~setVar('buttonText', () => {
              if (data.button_text) return data.button_text;
              if (helpers.var.widgetMoreCaption) return helpers.var.widgetMoreCaption;
              return '';
            })}}
            {{~fill(helpers.partial('custom_mindtrip/form'), {
              data: data,
              buttonText: helpers.var.buttonText(),
              buttonClasses:
                (typeof data.link_or_mindtrip === 'string' && data.link_or_mindtrip.includes('link'))
                  ? 'button-arrow'
                  : 'mindtrip-button button-arrow stays-blue',
              title: data.title,
              templateLinkOrButton: 'link',
              userInputStyle: 'gray-border-white-icon',
              logoHoverStyle: 'white-to-blue',
              var: helpers.var
            })}}
          {{/}}

          {{:type}}
            {{~setVar('quickview', {
              type: data.type,
              recid: data.recid,
              text: global.translations["translations.static.leo"].quick_view
            })}}
            {{~fill(helpers.partial('custom_quickview/button'), helpers.var.quickview)}}
          {{/}}
        </footer>
      </div>
    </div>
  </div>
</script>
