</section>

<script>
	require([], function() {
		const root = 
			document.querySelector('[data-guid="9e605200-4d82-4338-b998-2cb2e24169f1"]');
		const comboPanelStyle = root.closest('[data-combo-panel-style]');
		if (comboPanelStyle) {
			const button = root.querySelector('.mindtrip-form button');
			if (button) {
				if (
					comboPanelStyle.dataset.comboPanelStyle === 'variant_one' ||
						comboPanelStyle.dataset.comboPanelStyle === 'variant_two' ||
							comboPanelStyle.dataset.comboPanelStyle === 'variant_three'
				) {
					button.classList.add('blue-to-white');
				} else if(
					comboPanelStyle.dataset.comboPanelStyle === 'default'
				) {
					button.classList.add('white-to-blue');
				}
			}
		}
	});
</script></div>
