	style="opacity: 1;"
>
	
		

	<div class="inner center h1 ">

		<div class="title-cont">
			
				 
					<h1 class="title h1"> 
						Theme Parks 
					</h1>
				
			
			
				<p class="description">
					Live your own unforgettable adventures at the world’s top theme parks. The pioneering   
magic of WALT DISNEY WORLD® Resort, aquatic wonderlands at SeaWorld® Orlando, epic   
experiences at Universal Orlando Resort, and family fun at LEGOLAND® Florida Resort —   
Orlando theme parks make dreams come true.
				</p>
			
			
				


	<form
		class="mindtrip-form"
		
		
	>
		
			<textarea hidden class="mindtrip-prompt">Provide an overview of Walt Disney World Resort, Universal Orlando Resort, SeaWorld Orlando and LEGOLAND Florida.</textarea>
		
		
		
		
		
			<input hidden class="mindtrip-hint" value="Ask follow up questions such as when are they coming, who are they coming with and how many people.">
		
		
			<button
				type="submit"
				class="mindtrip-button button-default white-to-blue"
				data-gtm-click
				data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "MindTrip%20%7C%20Open%20Chat%2C%20With%20Prompt", "interactionText" : "AI%20Assistance" } }'
			>
				<div
					class="button-img"
				>
					<img
						class="md-blue"
						src="/includes/client_public/assets/shared/icons/mindtrip-logo-md-blue.svg"
						alt="Mindtrip"
					>
					<img
						class="dark-blue"
						src="/includes/client_public/assets/shared/icons/mindtrip-logo-dark-blue.svg"
						alt="Mindtrip"
					>
					<img
						class="white"
						src="/includes/client_public/assets/shared/icons/mindtrip-logo-white.svg"
						alt="Mindtrip"
					>
				</div>
				<span
					class="button-text"
				>
					AI Assistance
				</span>
			</button>
		
	</form>



			
		</div>
	</div>

	
</section>

<script>
	require([], function() {
		const root = 
			document.querySelector('[data-guid="60b98874-01c6-44cc-9e16-a5e83fa768be"]');
		const comboPanelStyle = root.closest('[data-combo-panel-style]');
		if (comboPanelStyle) {
			const button = root.querySelector('.mindtrip-form button');
			if (button) {
				if (
					comboPanelStyle.dataset.comboPanelStyle === 'variant_one' ||
						comboPanelStyle.dataset.comboPanelStyle === 'variant_two' ||
							comboPanelStyle.dataset.comboPanelStyle === 'variant_three'
				) {
					button.classList.add('blue-to-white');
				} else if(
					comboPanelStyle.dataset.comboPanelStyle === 'default'
				) {
					button.classList.add('white-to-blue');
				}
			}
		}
	});
</script></div>
