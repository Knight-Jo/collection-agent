				</h4>
			{{/}}
			{{:description}}
				<p>{{plainDescription(helpers.var.config.descriptionTruncation)}}</p>
			{{/}}
			{{:link}}
				{{:button_text}}
					<a 
						class="button-default read-more notranslate" 
						href="{{link.url}}" 
						aria-label="{{title}} {{button_text}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
            role="button"
