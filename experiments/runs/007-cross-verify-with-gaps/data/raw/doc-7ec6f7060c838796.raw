<section
	class="widget-heading core-styles"
	data-slides-across="1"
	data-guid="fe59fe36-0975-4b9a-8bea-ba70bb2d8a77"
	data-js="plugins_collections_custom_collection_default_package"
	data-gtm-vars='{ "tClient_ga4" : { "eventName" : "widget_interaction", "widgetName" : "Custom Heading", "interactionSource" : "widget" } }'
	style="opacity: 1;"
>
	
		

	<div id="legoland" class="inner center h2 ">

		<div class="title-cont">
			
				 
					<h2 class="title h2"> 
						LEGOLAND® Florida Resort 
					</h2>
				
			
			
				<p class="description">
					Built for kids 2 to 12, LEGOLAND® Florida Resort is a multi-day destination. It includes the interactive LEGOLAND® Florida Theme Park with rides, shows and attractions inspired by LEGO® brands and characters, plus LEGOLAND® Water Park, SEA LIFE Florida Aquarium and Peppa Pig Theme Park, designed to be the ultimate day for little ones.
				</p>
			
			
				




	
		<a 
			class="button-default"
			href="https://www.visitorlando.com/things-to-do/theme-parks/legoland-florida-resort/" 
			target="_self" 
			aria-label="LEGOLAND® Florida Resort "
			data-gtm-click
			data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Button", "interactionUrl" : "https%3A%2F%2Fwww.visitorlando.com%2Fthings-to-do%2Ftheme-parks%2Flegoland-florida-resort%2F", "interactionText" : "Explore" } }'
		>
			Explore
		</a>
	

			
		</div>
	</div>

	
</section>

<script>
	require([], function() {
		const root = 
			document.querySelector('[data-guid="fe59fe36-0975-4b9a-8bea-ba70bb2d8a77"]');
		const comboPanelStyle = root.closest('[data-combo-panel-style]');
		if (comboPanelStyle) {
			const button = root.querySelector('.mindtrip-form button');
			if (button) {
				if (
					comboPanelStyle.dataset.comboPanelStyle === 'variant_one' ||
						comboPanelStyle.dataset.comboPanelStyle === 'variant_two' ||
							comboPanelStyle.dataset.comboPanelStyle === 'variant_three'
				) {
					button.classList.add('blue-to-white');
				} else if(
					comboPanelStyle.dataset.comboPanelStyle === 'default'
				) {
					button.classList.add('white-to-blue');
				}
			}
		}
	});
</script></div>
