	<div id="uor" class="inner center h2 ">

		<div class="title-cont">
			
				 
					<h2 class="title h2"> 
						Universal Orlando Resort 
					</h2>
				
			
			
				<p class="description">
					Play, scream and laugh with some of the biggest characters in movies, TV and pop culture at Universal Orlando Resort. In addition to four incredible theme parks, including a water theme park, Universal Orlando Resort offers entertainment, shopping and dining at Universal CityWalk, immersive resorts, and more.
				</p>
			
			
				




	
		<a 
			class="button-default"
			href="https://www.visitorlando.com/things-to-do/theme-parks/universal-orlando-resort/" 
