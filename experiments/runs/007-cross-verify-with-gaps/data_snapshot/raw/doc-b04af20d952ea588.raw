<style type="text/css">
    .rn-newsTitle .rn-container {padding: 0 13px;}
    .rn-newsTitle .rn-container .rn-footer .rn-domainName {color: #A9ABB4;font-size: 12px;} 
    .rn-newsTitle .rn-container .rn-footer .rn-icon-hot {font-size: 12px;} 
    .rn-newsTitle .rn-container .rn-footer .dislike-btn {background-image: url(https://b.bdstatic.com/searchbox/image/gcp/20231026/2626341215.png);top: -13.25px}
    .rn-newsTitle:not(.newsTitleTop) .rn-container .rn-tpl1 {padding: 13px 0px 10px 0px;border-top:0.3px solid #EEEEEE;}
    .rn-newsTitle .rn-container .rn-h1 {line-height: .25rem;font-size: 18px;margin-bottom: 5px;color: #1E1F24;}
    .rn-newsTitle .rn-container .rn-footer {margin-top: 0;margin-bottom: 0;flex-wrap: wrap;align-items: center;font-size: 0;color: #999;}
    .rn-newsTitle .rn-container .rn-footer span, .rn-newsTitle .rn-container .rn-footer p {font-size: 13px;}
    .rn-newsTitle .rn-container .rn-footer .rn-icon-hot {margin-right: 8px;padding: 0;height: auto !important;border: none !important;border-radius: 0 !important;line-height: normal !important;font-size: 13px;color: #ec4345;}
