<script>
	require([
		'plugins_nav_custom_nav_header',
	], function(
		headerNav,
	) {
		const root = document.querySelector('[data-guid="9f208954-1a24-41b6-9ada-23e14b46abd7"][data-initialized="false"]');
		if (root) {
			const translations = JSON.parse(document.querySelector('[data-translations="9f208954-1a24-41b6-9ada-23e14b46abd7"]').innerHTML);
			const navDepth = 3;
	
			const mainNav = root.closest('[data-main-nav]');
			const secondaryNav = root.closest('[data-secondary-nav]');
	
			if (mainNav) {
				const mainMenu = mainNav.closest('[data-main-menu]');
				headerNav.init({
					root: mainMenu,
					selector: '[data-main-nav]',
					depth: navDepth,
					translations,
				});
			}
	
			if (secondaryNav) {
				const panelHeader = secondaryNav.closest('[data-panel-header]');
				headerNav.init({
					root: panelHeader,
					selector: '[data-secondary-nav]',
					depth: navDepth,
					translations,
				});
			}

			root.setAttribute('data-initialized', 'true');
		}
	});
</script>
