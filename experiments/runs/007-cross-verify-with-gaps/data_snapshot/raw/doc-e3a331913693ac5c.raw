				</span>
	
				<button 
					class="glide__arrow blue-dark glide__arrow--right" 
					aria-label="next slide" 
					data-gtm-click 
					data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Slider | Next Slide", "interactionText" : ">" } }'
					data-arrow="right"
				>
					<i class="fas fa-arrow-right" aria-hidden="true"></i>
				</button>
			</div>
		</header>
		<div class="slider-cont glide" data-glide-slider>
			<span class="slider-gradient"></span>
			<div class="items-container" data-sv-items-container>
				<script type="text/template" data-sv-items-template>
					<div class="glide__track" data-glide-el="track">
						<div class="glide__slides" data-slides>
							
								{{~exec(function() {
									helpers.var = { ...helpers.var, ...data.var, ...global.helpersVar};
								})}}
								{{#items}}
									{{~setVar('isDTN', data.isDTN && !data.title.length && global.templateData.adunits && global.templateData.adunits.length)}}
									<article class="slide glide__slide">
										<div class="inner" data-gtm-vars='{ "tClient_ga4" : { "interactionSource" : "widget"{{:itemCategory}}, "itemCategory" : "{{%%itemCategory}}"{{/}}{{:itemSubcategory}}, "itemSubcategory" : "{{%%itemSubcategory}}"{{/}}{{:city}}, "itemCity" : "{{%%city}}"{{?:listings}}, "itemCity" : "{{%%listings.0.city}}"{{/}}{{:region}}, "itemRegion" : "{{%%region}}"{{?:listings}}, "itemRegion" : "{{%%listings.0.region}}"{{/}}{{:recid}}, "itemId" : "{{%%recid}}"{{/}}{{:accountId}}, "acctId" : "{{%%accountId}}"{{?:acctid}}, "acctId" : "{{%%acctid}}"{{/}}{{:~equal(data.featuredItem && data.featuredItem === true, true)}}, "featuredItem" : true{{?:~equal(data.featuredItem === undefined, false)}}, "featuredItem" : false{{/}}{{:memberInfo}}, "memberInfo" : "{{%%memberInfo}}"{{/}} } }'>
											{{:link}}
												<a 
													href="{{link.url}}" 
													class="slide-wrapper" 
													title="{{title}}" 
													target="{{link.target}}"
													aria-label="{{title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
												>
											{{/link}}
												<div 
													data-asset 
													target="{{link.target}}"
													aria-label="{{title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
													data-gtm-click 
													data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "{{:isVideo()}}Video Click{{?}}Image{{/}}", "itemName" : "{{%%title}}", "interactionUrl": "{{link.url}}" } }'
												>
													<div class="img-cont" data-img-cont>
														{{:isDTN}}
															<span class="sponsored">Sponsored</span>
														{{/}}
														{{:asset.resource}}
															{{~setVar("resource", helpers.plugins.cloudinary.createResource(data.asset.resource))}}
														{{/asset.resource}}
														
														{{:~var.resource}}
															<picture>
																<source srcset="{{~var.resource.getThumbnailUrl({ height : 600, width : 600, crop : 'fill', quality : 65 })}}" media="(min-width: 1025px)">
																<source srcset="{{~var.resource.getThumbnailUrl({ height : 700, width : 700, crop : 'fill', quality : 65 })}}" media="(min-width: 640px)">
																<img 
																	data-sv-alt="{{:image.alt_text_raw}}{{%image.alt_text_raw}}{{?:image.title}}{{%image.title}}{{?:title}}{{%title}}{{/}}"
																	data-sv-alt-mobile="{{:imagemobile.alt_text_raw}}{{%imagemobile.alt_text_raw}}{{?:imagemobile.title}}{{%imagemobile.title}}{{?:title}}{{%title}}{{/}}"
																	srcset="{{~var.resource.getThumbnailUrl({ 'width' : 475, 'height' : 475, 'crop' : 'fill'})}}"
																	alt="{{:imagemobile.alt_text_raw}}{{%imagemobile.alt_text_raw}}{{?:imagemobile.title}}{{%imagemobile.title}}{{?:title}}{{%title}}{{/}}"
																>
															</picture>
															{{~fill(helpers.partial('custom_asset_credits'), data.asset)}}
														{{?}}
															<img src="/includes/public/assets/images/default.png">
														{{/}}
													</div>
													
													<div class="content-section">
														{{:~var.showCategories}}
															{{:categories}}
																<div class="categories">
																	{{#categories}}
																		<span class="cat">{{title}}</span>
																	{{/}}
																</div>
															{{/}}
														{{/}}
														{{:title}}
															{{~setVar("slideHeading", data.templateTitle ? 3 : 2)}}
															{{~setVar("listingsFeed", data.listingsFeed)}}
															<h{{~var.slideHeading}} class="slide-title{{:~var.listingsFeed}} notranslate{{/}}">
																<div 
																	target="{{link.target}}"
																	aria-label="{{title}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
																	data-gtm-click 
																	data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Title", "itemName" : "{{%%title}}", "interactionUrl": "{{%%link.url}}", "interactionText" : "{{%%title}}" } }'
																>
																	{{title}}
																</div>
															</h{{~var.slideHeading}}>
														{{/}}
														
														{{:description}}
															<p class="slide-desc">{{description}}</p>
														{{/}}
														
														<footer class="slide-footer" data-gtm-vars='{ "tClient_ga4" : { "itemName" : "{{%%title}}" } }'>
															{{:link}}
																{{~setVar('DTNmoreCaption', data.isdtn && data.button_text)}}
																<span 
																	class="read-more button-arrow translate" 
																	target="{{link.target}}" 
																	aria-label="{{title}} {{:~var.DTNmoreCaption}}{{button_text}}{{?}}{{*templateData.more_caption}}{{/}}{{:link}}{{:~equal(data.link.target, '_blank')}} - (opens in new tab){{?}}{{/}}{{/}}"
																	data-gtm-click 
																	data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "{{%%*templateData.more_caption}}", "interactionUrl": "{{%%link.url}}", "interactionText" : "{{*templateData.more_caption}}" } }'
																>
																	{{:~var.DTNmoreCaption}}{{button_text}}{{?}}{{*templateData.more_caption}}{{/}}
																</span>
															{{/}}
															{{:~var.tripbuilderActive}}
																{{!isDTN}}
																	<div class="tripbuilder" data-tb-button data-tb-recid="{{recid}}" data-tb-type="{{~var.feed}}"></div>
																{{/}}
															{{/}}
														</footer>
													</div>
												</div>
											{{:link}}
												</a>
											{{/link}}
										</div>
									</article>
								{{/items}}
							
						</div>
					</div>
				</script>
			</div>
		</div>
	</div>
	
</div>


<script>
	require([
		'plugins_collections_custom_collection_helper',
		"plugins_common_custom_glidejs",
		"jquery", 
		"sv_load!plugins_dtn",
