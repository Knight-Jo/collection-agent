%20even%20the%20most%20frequent%20visitors%20will%20always%20find%20fresh%20ways%20to%20create%20lasting%20memories%2C%20year%20after%20year%2C%20in%20Orlando%3A%20Theme%20Park%20Capital%20of%20the%20World.%3Cbr%20%2F%3E%0D%0A%26nbsp%3B%3C%2Fp%3E%0D%0A%09%09%09%09%0D%0A%09%09%09%09%09%0D%0A%0D%0A%0D%0A%0D%0A%0D%0A%09%0D%0A%09%09%3Ca%20%0D%0A%09%09%09class%3D%22asm-button%20button-primary%20button-filled%20button-arrow%20small%22%0D%0A%09%09%09href%3D%22https%3A%2F%2Fwww.visitorlando.com%2Fthings-to-do%2Ftheme-parks%2F%22%20%0D%0A%09%09%09target%3D%22_self%22%20%0D%0A%09%09%09aria-label%3D%22%20%22%0D%0A%09%09%09data-gtm-click%0D%0A%09%09%09data-gtm-vars%3D%27%7B%20%22tClient_ga4%22%20%3A%20%7B%20%22linkObject%22%20%3A%20%22Button%22%2C%20%22interactionUrl%22%20%3A%20%22https%253A%252F%252Fwww.visitorlando.com%252Fthings-to-do%252Ftheme-parks%252F%22%2C%20%22interactionText%22%20%3A%20%22Explore%22%20%7D%20%7D%27%0D%0A%09%09%3E%0D%0A%09%09%09Explore%0D%0A%09%09%3C%2Fa%3E%0D%0A%09%0D%0A%0D%0A%09%09%09%09%0D%0A%09%09%09%3C%2Fdiv%3E%0D%0A%09%09%3C%2Fdiv%3E%0D%0A%09%3C%2Fli%3E%0D%0A%0D%0A%09%09%09%0D%0A%09%09%3C%2Fdiv%3E%0D%0A%09%3C%2Fdiv%3E%0D%0A%3C%2Fsection%3E%0D%0A%0D%0A%3Cscript%20type%3D%22application%2Fld%2Bjson%22%20data-sv-accordionschema%3E%0D%0A%7B%0D%0A%09%22%40context%22%3A%20%22https%3A%2F%2Fschema.org%22%2C%0D%0A%09%22%40type%22%3A%20%22FAQPage%22%2C%0D%0A%09%22mainEntity%22%3A%20%5B%0D%0A%09%0D%0A%09%09%7B%0D%0A%09%09%09%22%40type%22%3A%20%22Question%22%2C%0D%0A%09%09%09%22name%22%3A%20%22World-Famous%20Theme%20Parks%22%2C%0D%0A%09%09%09%22acceptedAnswer%22%3A%20%7B%0D%0A%09%09%09%09%22%40type%22%3A%20%22Answer%22%2C%0D%0A%09%09%09%09%22text%22%3A%20%22Immerse%20yourself%20in%20unforgettable%20adventures%20at%20the%20world%26rsquo%3Bs%20top%20theme%20parks%20when%20you%20visit%20Orlando.%20Whether%20it%20is%20the%20magic%20of%20WALT%20DISNEY%20WORLD%26reg%3B%20Resort%2C%20an%20aquatic%20wonderland%20at%20SeaWorld%26reg%3B%20Orlando%2C%20endless%20excitement%20at%20Universal%20Orlando%20Resort%2C%20or%20building%20family%20fun%20at%20LEGOLAND%26reg%3B%20Florida%20Resort%2C%20we%20have%20theme%20parks%20that%20are%20perfect%20for%20you.%20Our%20signature%20attractions%20continually%20have%20new%20projects%20on%20the%20horizon%2C%20too%2C%20so%20even%20the%20most%20frequent%20visitors%20will%20always%20find%20fresh%20ways%20to%20create%20lasting%20memories%2C%20year%20after%20year%2C%20in%20Orlando%3A%20Theme%20Park%20Capital%20of%20the%20World.%20%26nbsp%3B%20%3Ca%20href%3D%27https%3A%2F%2Fwww.visitorlando.com%2Fthings-to-do%2Ftheme-parks%2F%27%3EView%20Answer%3C%2Fa%3E%22%0D%0A%09%09%09%09%2C%22url%22%3A%20%22https%3A%2F%2Fwww.visitorlando.com%2Fthings-to-do%2Ftheme-parks%2F%22%0D%0A%09%09%09%7D%0D%0A%09%09%7D%0D%0A%09%0D%0A%09%5D%0D%0A%7D%0D%0A%3C%2Fscript%3E%0D%0A%3Cscript%3E%0D%0A%09window.addEventListener(%22load%22%2C%20function()%7B%0D%0A%09%09%2F%2F%20Merges%20schema%20if%20more%20than%20one%20widget%20on%20page.%20Must%20fire%20on%20page%20load%20to%20avoid%20errors%20in%20Google%20Search%20Console%0D%0A%09%09var%20schemaBlock%20%3D%20document.querySelectorAll(%22%5Bdata-sv-accordionschema%5D%22)%3B%0D%0A%09%09if(schemaBlock%5B0%5D.dataset.merged%20%3D%3D%3D%20%22true%22)%7B%0D%0A%09%09%09return%3B%0D%0A%09%09%7D%0D%0A%09%09var%20parentBlock%2C%20parentBlockMainEntity%3B%0D%0A%09%09var%20additionalSchema%20%3D%20%5B%5D%3B%0D%0A%09%09schemaBlock.forEach(block%20%3D%3E%20%7B%0D%0A%09%09%09if(schemaBlock%5B0%5D%20%3D%3D%3D%20block)%7B%0D%0A%09%09%09%09parentBlock%20%3D%20block%3B%0D%0A%09%09%09%09parentBlockMainEntity%20%3D%20JSON.parse(parentBlock.innerHTML)%3B%0D%0A%09%09%09%7Delse%7B%0D%0A%09%09%09%09var%20markup%20%3D%20JSON.parse(block.innerHTML)%5B%22mainEntity%22%5D%0D%0A%09%09%09%09parentBlockMainEntity.mainEntity.push(...markup)%3B%0D%0A%09%09%09%09block.parentNode.removeChild(block)%3B%0D%0A%09%09%09%7D%0D%0A%09%09%7D)%3B%0D%0A%09%09parentBlockMainEntity%20%3D%20JSON.stringify(parentBlockMainEntity)%3B%0D%0A%09%09parentBlock.innerHTML%20%3D%20parentBlockMainEntity%3B%0D%0A%09%09parentBlock.setAttribute(%22data-merged%22%2C%20%22true%22)%3B%0D%0A%09%7D)%3B%0D%0A%0D%0A%09require(%5B%27plugins_common_custom_utils%27%2C%20%27domReady!%27%5D%2C%20function(utils)%20%7B%0D%0A%09%09const%20root%20%3D%20document.querySelector(%27%5Bdata-guid%3D%22457d18df-9396-4378-b574-52ac21489bbd%22%5D%27)%3B%0D%0A%09%09const%20childTabs%20%3D%20Array.from(root.querySelectorAll(%27%5Bdata-accordion%5D%20%5Bdata-accordion-item%5D%27))%3B%0D%0A%09%09const%20tabContentEl%20%3D%20root.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%09%09const%20cs%20%3D%20tabContentEl%20%3F%20getComputedStyle(tabContentEl)%20%3A%20null%3B%0D%0A%09%09const%20drawerTransitionDuration%20%3D%20parseFloat(cs%20%26%26%20cs.getPropertyValue(%27transition-duration%27))%20*%201000%3B%0D%0A%09%09const%20resizeEvents%20%3D%20%5B%27resize%27%2C%20%27orientationchange%27%5D%3B%0D%0A%09%09const%20focusableQuery%20%3D%20%27a%2C%20area%2C%20button%2C%20input%2C%20object%2C%20select%2C%20textarea%2C%20%5Btabindex%5D%27%3B%0D%0A%0D%0A%09%09function%20open(el)%20%7B%0D%0A%09%09%09const%20parent%20%3D%20el.parentElement%3B%0D%0A%09%09%09const%20panel%20%3D%20parent.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%09%09%09const%20maxHeight%20%3D%20%60%24%7Bpanel.scrollHeight%7Dpx%60%3B%0D%0A%09%09%09const%20asset%20%3D%20root.querySelector(%60%5Bdata-asset%3D%22%24%7Bel.parentNode.dataset.assetId%7D%22%5D%60)%3B%0D%0A%0D%0A%09%09%09parent.classList.add(%27active%27)%3B%0D%0A%09%09%09asset.classList.add(%27active%27)%3B%0D%0A%0D%0A%09%09%09el.setAttribute(%27open%27%2C%20true)%3B%0D%0A%09%09%09el.setAttribute(%27aria-expanded%27%2C%20true)%3B%0D%0A%0D%0A%09%09%09panel.setAttribute(%27aria-hidden%27%2C%20false)%3B%0D%0A%09%09%09panel.style.maxHeight%20%3D%20maxHeight%3B%0D%0A%09%09%09panel.querySelectorAll(focusableQuery).forEach(el%20%3D%3E%20el.setAttribute(%27tabindex%27%2C%200))%0D%0A%09%09%7D%0D%0A%0D%0A%09%09function%20close(el%2C%20sameNode)%20%7B%0D%0A%09%09%09const%20parent%20%3D%20el.parentElement%3B%0D%0A%09%09%09const%20panel%20%3D%20parent.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%09%09%09const%20asset%20%3D%20root.querySelector(%60%5Bdata-asset%3D%22%24%7Bel.parentNode.dataset.assetId%7D%22%5D%60)%3B%0D%0A%09%09%09const%20activeAsset%20%3D%20root.querySelector(%60%5Bdata-asset%5D.active%60)%3B%0D%0A%0D%0A%09%09%09parent.classList.remove(%27active%27)%3B%0D%0A%09%09%09%2F%2F%20Keeps%20the%20asset%20active%20when%20the%20corresponding%20accordion%20is%20closed%0D%0A%09%09%09if%20(sameNode)%20%7B%0D%0A%09%09%09%7D%20else%20%7B%0D%0A%09%09%09%09activeAsset.classList.remove(%27active%27)%3B%0D%0A%09%09%09%7D%0D%0A%0D%0A%09%09%09el.removeAttribute(%27open%27)%3B%0D%0A%09%09%09el.setAttribute(%27aria-expanded%27%2C%20false)%3B%0D%0A%0D%0A%09%09%09panel.setAttribute(%27aria-hidden%27%2C%20true)%3B%0D%0A%09%09%09panel.style.maxHeight%20%3D%20%27%27%3B%0D%0A%09%09%09panel.querySelectorAll(focusableQuery).forEach(el%20%3D%3E%20el.setAttribute(%27tabindex%27%2C%20-1))%3B%0D%0A%09%09%7D%0D%0A%0D%0A%09%09function%20resizeFn()%20%7B%0D%0A%09%09%09const%20openTabs%20%3D%20childTabs.filter(tab%20%3D%3E%20tab.classList.contains(%27active%27))%3B%0D%0A%0D%0A%09%09%09if%20(!openTabs%20%7C%7C%20!openTabs.length)%20return%3B%0D%0A%0D%0A%09%09%09openTabs.forEach(tab%20%3D%3E%20%7B%0D%0A%09%09%09%09const%20tabContent%20%3D%20tab.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%0D%0A%09%09%09%09tabContent.style.maxHeight%20%3D%20%60%24%7BtabContent.scrollHeight%7Dpx%60%3B%0D%0A%09%09%09%7D)%3B%0D%0A%09%09%7D%0D%0A%0D%0A%09%09%2F%2F%20--------%20INIT%20---------%20%2F%2F%0D%0A%09%09root.querySelectorAll(%60%5Bdata-tab-content%5D%20%3Ais(%24%7BfocusableQuery%7D%60).forEach(el%20%3D%3E%20el.setAttribute(%27tabindex%27%2C%20-1))%0D%0A%0D%0A%09%09%2F%2F%20Opens%20the%20first%20accordion%20by%20default%20on%20page%20load%0D%0A%09%09root.querySelectorAll(%27%5Bdata-accordion-title%5D%27).forEach(node%20%3D%3E%20%7B%0D%0A%09%09%09if%20(node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09open(node)%3B%0D%0A%09%09%09%7D%20return%3B%0D%0A%09%09%7D)%0D%0A%0D%0A%09%09%2F%2F%20Handles%20the%20opening%20and%20closing%20of%20accordion%20tabs%20(only%20one%20can%20be%20opened%20at%20a%20time)%20%0D%0A%09%09root.querySelectorAll(%27%5Bdata-accordion-item%5D%20%5Bdata-accordion-title%5D%27).forEach(node%20%3D%3E%20node.addEventListener(%27click%27%2C%20()%20%3D%3E%20%7B%0D%0A%09%09%09if%20(node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09close(node%2C%20true)%0D%0A%09%09%09%7D%20else%20if%20(root.querySelectorAll(%27%5Bdata-accordion-item%5D.active%27).length%20%3D%3D%3D%200)%20%7B%0D%0A%09%09%09%09close(node%2C%20false)%0D%0A%09%09%09%09open(node)%0D%0A%09%09%09%7D%20else%20if%20(!node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09root.querySelectorAll(%27%5Bdata-accordion-title%5D%27).forEach(node%20%3D%3E%20%7B%0D%0A%09%09%09%09%09if%20(node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09%09%09close(node%2C%20false)%3B%0D%0A%09%09%09%09%09%7D%20return%0D%0A%09%09%09%09%7D)%0D%0A%09%09%09%09open(node)%3B%0D%0A%09%09%09%7D%0D%0A%09%09%7D))%3B%0D%0A%0D%0A%09%09%2F%2F%20when%20resizing%20the%20window%2C%20make%20sure%20the%20open%20accordions%20don%27t%20allow%20the%20content%20to%20overflow%0D%0A%09%09resizeEvents.forEach(ev%20%3D%3E%20window.addEventListener(ev%2C%20utils.debounce(resizeFn%2C%20200)))%3B%0D%0A%09%7D)%3B%0D%0A%3C%2Fscript%3E%3C%2Fdiv%3E"
	class="inner-tab-cont"
>
</div></div>
	</div>
	
	<script type="text/template" data-sv-tab-button>
		
			{{#data}}
				<li {{:@first}}class="active first-tab-button"{{/first}}>
					<button 
						{{:no_translate}}class="notranslate"{{/}}
						data-sv-tab-target="{{%guid}}" 
						aria-role="tab" 
						aria-selected="{{:@first}}true{{?}}false{{/}}" 
						sv-tabindex="{{:@first}}0{{?}}-1{{/}}" 
						id="{{guid}}-control" 
						aria-controls="{{%guid}}-panel"
					>
						{{title}}
					</button>
				</li>
			{{/data}}
		
	</script>
</section>

<script>
	require(['goatee'], function(goatee) {
		const ACTIVE_CLASS = 'active';
		const root = document.querySelector('[data-guid="16aa8d0e-1148-4ffc-87ca-c7f0f7e844ac"]');
		const tabEl = root.querySelector('[data-sv-tab-list]');
		const tabCont = root.querySelector('[data-sv-tab-outer]');
		const tabButton = root.querySelector("[data-sv-tab-button]").innerHTML;

		//This variable determines if we are using inner-tab panels or not.
		const HAS_PANELS = (root.querySelectorAll('[data-sv-tab-title]').length > 0) ? true : false;

		// Change the .widget-title selector if you want to generate tabs from another field.
		const tabs = HAS_PANELS ? root.querySelectorAll('[data-sv-tab-title]') : root.querySelectorAll(".widget-title"); 

		if (tabs.length > 0) {
			const data = Array.from(tabs).map((tab) => (
				{
					title: HAS_PANELS ? tab.getAttribute('data-sv-tab-title') : tab.textContent,
					no_translate: HAS_PANELS ? tab.getAttribute('data-sv-tab-translate') : tab.textContent,
					guid: HAS_PANELS ? tab.getAttribute('data-guid') : tab.closest('[data-guid]').getAttribute('data-guid')
				}
			));

			function clearActive() {
				if (HAS_PANELS) {
					tabCont.querySelector('.inner-tab-cont.active').classList.remove(ACTIVE_CLASS)
				} else {
					tabCont.querySelector('.contentRender.active').classList.remove(ACTIVE_CLASS)
				}

				root.querySelectorAll('[data-sv-tab-target]').forEach((button) => {
					button.setAttribute('aria-selected', 'false');
					button.setAttribute('sv-tabindex', '-1');
					button.parentNode.classList.remove('active');
				});
			}

			function activateTab({ button, tab }) {
				tabCont.addEventListener('transitionend', () => {
					clearActive();
					tab.classList.add(ACTIVE_CLASS);
					button.setAttribute('aria-selected', 'true');
					button.setAttribute('sv-tabindex', '0');
					button.parentNode.classList.add('active');
					tabCont.classList.remove('animating');
				}, { once: true });
				tabCont.classList.add('animating');
				const event = new CustomEvent('handleLazyLoadTabClick', { detail: { guid: '16aa8d0e-1148-4ffc-87ca-c7f0f7e844ac' } });
				window.dispatchEvent(event);
			}

			function handleClick(e) {
				if (e.currentTarget.getAttribute('aria-selected') === 'true') return;
				const targetId = e.currentTarget.getAttribute('data-sv-tab-target');
				const tab = HAS_PANELS ? root.querySelector(`[data-guid="${targetId}"]`) : root.querySelector(`[data-guid="${targetId}"]`).parentNode;
				handleLoadTab(tab);
				activateTab({ button: e.currentTarget, tab });
			}

			function handleLoadTab(tab) {
				if (
					!tab.hasAttribute('data-loaded') &&
						tab.dataset?.content
				) {
					const component = decodeURIComponent(tab.dataset.content);
					const range = document.createRange();
					const content = range.createContextualFragment(component);
					tab.setAttribute('data-loaded', true);
					tab.appendChild(content);
					delete tab.dataset.content;
				}
			}

			function handleKeydown(e) {
				const currentId = e.currentTarget.getAttribute('data-sv-tab-target');
				const currentIndex = data.findIndex(({ guid }) => guid === currentId);
				let nextIndex;

				switch (e.key) {
					case 'ArrowUp':
						nextIndex = currentIndex - 1;
						if (nextIndex < 0) nextIndex = data.length - 1;
						break;
					case 'ArrowDown':
						nextIndex = currentIndex + 1;
						if (nextIndex == data.length) nextIndex = 0;
						break;
					case 'ArrowLeft':
						nextIndex = currentIndex - 1;
						if (nextIndex < 0) nextIndex = data.length - 1;
						break;
					case 'ArrowRight':
						nextIndex = currentIndex + 1;
						if (nextIndex == data.length) nextIndex = 0;
						break;
					case 'Home':
						nextIndex = 0;
						break;
					case 'End':
						nextIndex = data.length - 1;
						break;
					default:
						break;
				}

				if (nextIndex !== undefined) {
					const nextId = data[+nextIndex].guid;
					const tab = HAS_PANELS ? root.querySelector(`[data-guid="${nextId}"]`) : root.querySelector(`[data-guid="${nextId}"]`).parentNode;
					const button = root.querySelector(`[data-sv-tab-target="${nextId}"]`);
					button.focus();
					activateTab({ button, tab });
				}
			}

			// Init Tabs
			if (HAS_PANELS) {
				Array.from(tabs)[0].classList.add('active');
			} else {
				root.querySelector('.tab-outer > div.contentRender:nth-child(1)').classList.add('active');;
			}

			let html = goatee.fill(tabButton, { data });
			tabEl.innerHTML = html;

			tabEl.querySelectorAll('li > button').forEach(item => {
				item.addEventListener('click', handleClick);
				item.addEventListener('keydown', handleKeydown);
			})
			const firstTab = root.querySelector(".first-tab-button");
			const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
							if (entry.isIntersecting && !entry.target.getAttribute('data-load-handled')) {
								entry.target.setAttribute('data-load-handled', true);
								const buttonEl = entry.target.querySelector('button');
								const targetId = buttonEl.getAttribute('data-sv-tab-target');
								const tab = HAS_PANELS ? root.querySelector(`[data-guid="${targetId}"]`) : root.querySelector(`[data-guid="${targetId}"]`).parentNode;
								handleLoadTab(tab);
								activateTab({ button: buttonEl, tab });
							}
					});
				}, {
				rootMargin: '250px 0px 250px 0px'
			});
			observer.observe(firstTab);
		}
	});
</script></div><div data-civid="6a74f10b64a4f090739584f2" class="contentRender contentRender_31 contentRender_type_panel contentRender_name_plugins_common_custom_tab_container" data-sv-time="0" data-sv-index="31" data-gtm-vars='{ "tCore" : { "contentNum" : "2" } }'>



