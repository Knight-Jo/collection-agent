	<div class="widget-inner">
		<header class="template-header">
			
				<div class="content-col translate">
					
						<h2 class="template-title">Unique Orlando Experiences</h2>
					
					
				</div>
			
	
			<div class="arrows hide">
				<button 
					class="glide__arrow blue-dark glide__arrow--left" 
					aria-label="previous slide" 
					data-gtm-click 
					data-gtm-vars='{ "tClient_ga4" : { "linkObject" : "Slider | Previous Slide", "interactionText" : "<" } }'
					data-arrow="left"
					disabled
				>
					<i class="fas fa-arrow-left" aria-hidden="true"></i>
				</button>
	
				<span class="slide-counter">
					<span data-current-slide>1</span>
					of 
