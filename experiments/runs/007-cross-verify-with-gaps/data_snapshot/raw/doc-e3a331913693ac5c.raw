put button:focus-visible img{outline:1px solid var(--sw-focus-color);outline-offset:5px;border-radius:1px}.mindtrip-form .keyword button{position:relative}.mindtrip-form .keyword button img{position:absolute}.mindtrip-form .keyword .search-icon-white{width:100%;height:100%}.mindtrip-form .keyword.white-border-white-icon .search-icon-white{display:none}.mindtrip-form .keyword:is(.gray-border-white-icon,.white-border-white-icon) .search-icon-white{display:block}.mindtrip-form .keyword.gray-border-white-icon :is(.search-icon-md-blue,.search-icon-dark-blue){display:none}.mindtrip-form .keyword.gray-border-white-icon :is(input,button){border:2px solid var(--gray-dark)}.mindtrip-form .keyword.white-border-white-icon :is(input,button){border:2px solid var(--white)}.mindtrip-form .keyword:is(.gray-border-white-icon,.white-border-white-icon) button{background-color:var(--blue);border-left:none}.mindtrip-form .keyword:is(.gray-border-white-icon,.white-border-white-icon) button:hover{background-color:var(--blue-dark)}.mindtrip-form button:not(.keyword button){display:flex;align-items:center;gap:8px}.mindtrip-form .button-img{position:relative;display:flex;align-items:center;width:20px;height:22px;flex-shrink:0}.mindtrip-form .button-img .md-blue,.mindtrip-form .button-img .white{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain}.mindtrip-form .button-text{flex:1}.mindtrip-form button.white-to-blue .md-blue{opacity:0;transition:opacity var(--transition-appendix)}.mindtrip-form button.white-to-blue .white{opacity:1;transition:opacity var(--transition-appendix)}.mindtrip-form button.white-to-blue:hover .md-blue{opacity:1}.mindtrip-form button.white-to-blue:hover .white{opacity:0}.mindtrip-form button.blue-to-white .md-blue{opacity:1;transition:opacity var(--transition-appendix)}.mindtrip-form button.blue-to-white .white{opacity:0;transition:opacity var(--transition-appendix)}.mindtrip-form button.blue-to-white:hover .md-blue{opacity:0}.mindtrip-form button.