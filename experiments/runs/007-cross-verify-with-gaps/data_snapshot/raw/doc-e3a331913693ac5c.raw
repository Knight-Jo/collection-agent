						let trackUrlFieldsArr = ['link.url'];
						if (helpers && helpers.numberOfMindtripLinksForDTNTracking) {
							if (helpers && helpers.numberOfMindtripLinksForDTNTracking > 1) {
								for (let i = 1; i < numberOfMindtripLinksForDTNTracking; i++) {
									trackUrlFieldsArr.push(`link_${i}.url`);
								}
							}
						}
						return trackUrlFieldsArr;
					}
					dtn.getAdUnitsGam({
						ids : ids,
						modelName : "plugins_collections_type_custom_slides",
						trackUrlFields : handleTrackUrlFieldsWithMindtrip(),
						mockFilter : { isdtn : true }
					}, function(err, temp) {
						if (err) { return cb(err); }
						items.unshift.apply(items, temp);
						cb(null);
					});
				},
				slides : function(cb) {
					var sanitize = function(input,max,mtxt) { 
						var tempsub = stringLib.stripHtml(input);
						return (tempsub.length > max) ? stringLib.substringOnWord(tempsub, max) + mtxt : tempsub;
					};

					if (!items || !items.length) return;

					items.map(function(item) {
						if (item.description !== undefined) {
							item.description = sanitize(item.description, 100, '...');
						}
						if (templateData.title) {
							item.templateTitle = true;
						}
						if (listingsFeed) {
							item.listingsFeed = true;
						}
						if (item.link && !item.link.target && !feed || item.link && item.dtn) {
							item.link.target = "_blank";
						} else {
							item.link.target = "_self";
						}
						if (!!item.asset && !!item.asset.resource_raw && !!item.asset.resource_raw.secure_url) {
							item.asset = {
								credits: item.asset.credits ?? '',
								custom_show_credits: item.asset.custom_show_credits ?? false,
								resource : {
									imageUrl : item.asset.resource_raw.secure_url
								}
							}
						} else if (item.asset === undefined) {
							item.asset = {
								resource : {
									imageUrl : defaultImageUrl
								}
							}
						}
					});

					var itemsHTML = goatee.fill(itemsTemplate, { items : items, templateData : templateData, var: helpers }, partials);
					itemsContainer.html(itemsHTML);

					startSlider(items);
					cb(null);
				},
				tripbuilder : function(cb) {
					if (!helpers.tripbuilderActive) { return cb(null); }

					const tbRoot = $('[data-guid="4ba7916d-f3e2-4fbe-b8b9-ad298579912b"]');
					tripbuilder.initButtons({
						root: tbRoot, // initButtons in old tripbuilder.js expects root to be a jQuery instance
						addButtonTemplate: `<button data-tb-add class="tripbuilder-button addTrip" aria-label="Add to Trip"></button>`,
						removeButtonTemplate: `<button data-tb-remove class="tripbuilder-button removeTrip" aria-label="Remove from Trip"></button>`
					});
					const buttons = 
						tbRoot.find('[data-tb-button]').each(function() {
							const parentButton = $(this)
							const recid = parentButton.attr('data-tb-recid');
							parentButton.find('button').each(function() {
								const button = $(this);
								if (button.attr('data-tb-add')) {
									parentButton.removeClass('active');
									parentButton.attr('aria-label', `Remove ${recIdTitleIndex[recid]} from Trip`);
								} else {
									parentButton.addClass('active');
									parentButton.attr('aria-label', `Add ${recIdTitleIndex[recid]} to Trip`);
								}
							});
							parentButton.click(function() {
								const button = $(this);
								if (button.hasClass('active')) {
									button.removeClass('active');
									button.attr('aria-label', `Remove ${recIdTitleIndex[recid]} from Trip`);
								} else {
									button.addClass('active');
									button.attr('aria-label', `Add ${recIdTitleIndex[recid]} to Trip`);
								}
							});
						});

					cb(null);
				}
			}, function(err) {
				if (err) { throw err; }
			});

			function startSlider(items) {
				const slidesCount = items.length;
				if (slidesCount > 0) {
					root.querySelector('.arrows.hide').classList.remove('hide');
				}
				const els = {
					arrows: Array.from(root.querySelectorAll('[data-arrow]')),
					slideNum: root.querySelector('[data-current-slide]'),
					slider: root.querySelector('[data-glide-slider]'),
					total: root.querySelector('[data-total-slides]')
				};
				els.total.textContent = slidesCount;
				const sliderOptions = JSON.parse(root.querySelector('[data-slider-options]').innerHTML);

				const slider = new Glide(els.slider, sliderOptions);

				slider.on('run', () => {
					els.slideNum.textContent = slider.index + 1;
					if (slider.index > 0) {
						root.querySelector('[data-arrow="left"]').removeAttribute('disabled');
					}
					else {
						root.querySelector('[data-arrow="left"]').setAttribute('disabled', true);
					}
				});
				els.arrows.forEach(el => el.addEventListener('click', () => {
					const direction = el.dataset.arrow === 'left' ? '<' : '>';
					slider.go(direction);
				}));
				slider.mount();
			}
		});
	});
</script></div><div data-civid="6a74f10b64a4f090739584d4" class="contentRender contentRender_16 contentRender_type_panel contentRender_name_plugins_common_custom_tab_container" data-sv-time="0" data-sv-index="16" data-gtm-vars='{ "tCore" : { "contentNum" : "1" } }'>



