	class="inner-tab-cont"
>
</div></div>
	</div>
	
	<script type="text/template" data-sv-tab-button>
		
			{{#data}}
				<li {{:@first}}class="active first-tab-button"{{/first}}>
					<button 
						{{:no_translate}}class="notranslate"{{/}}
						data-sv-tab-target="{{%guid}}" 
						aria-role="tab" 
						aria-selected="{{:@first}}true{{?}}false{{/}}" 
						sv-tabindex="{{:@first}}0{{?}}-1{{/}}" 
						id="{{guid}}-control" 
						aria-controls="{{%guid}}-panel"
					>
						{{title}}
					</button>
				</li>
			{{/data}}
		
	</script>
</section>

<script>
	require(['goatee'], function(goatee) {
		const ACTIVE_CLASS = 'active';
		const root = document.querySelector('[data-guid="d8230bb4-2f4a-4dda-8ec9-0e86bf65a550"]');
		const tabEl = root.querySelector('[data-sv-tab-list]');
		const tabCont = root.querySelector('[data-sv-tab-outer]');
		const tabButton = root.querySelector("[data-sv-tab-button]").innerHTML;

		//This variable determines if we are using inner-tab panels or not.
		const HAS_PANELS = (root.querySelectorAll('[data-sv-tab-title]').length > 0) ? true : false;

		// Change the .widget-title selector if you want to generate tabs from another field.
		const tabs = HAS_PANELS ? root.querySelectorAll('[data-sv-tab-title]') : root.querySelectorAll(".widget-title"); 

		if (tabs.length > 0) {
			const data = Array.from(tabs).map((tab) => (
				{
					title: HAS_PANELS ? tab.getAttribute('data-sv-tab-title') : tab.textContent,
					no_translate: HAS_PANELS ? tab.getAttribute('data-sv-tab-translate') : tab.textContent,
					guid: HAS_PANELS ? tab.getAttribute('data-guid') : tab.closest('[data-guid]').getAttribute('data-guid')
				}
			));

			function clearActive() {
				if (HAS_PANELS) {
					tabCont.querySelector('.inner-tab-cont.active').classList.remove(ACTIVE_CLASS)
				} else {
					tabCont.querySelector('.contentRender.active').classList.remove(ACTIVE_CLASS)
				}

				root.querySelectorAll('[data-sv-tab-target]').forEach((button) => {
					button.setAttribute('aria-selected', 'false');
					button.setAttribute('sv-tabindex', '-1');
					button.parentNode.classList.remove('active');
				});
			}

			function activateTab({ button, tab }) {
				tabCont.addEventListener('transitionend', () => {
					clearActive();
					tab.classList.add(ACTIVE_CLASS);
					button.setAttribute('aria-selected', 'true');
					button.setAttribute('sv-tabindex', '0');
					button.parentNode.classList.add('active');
					tabCont.classList.remove('animating');
				}, { once: true });
				tabCont.classList.add('animating');
				const event = new CustomEvent('handleLazyLoadTabClick', { detail: { guid: 'd8230bb4-2f4a-4dda-8ec9-0e86bf65a550' } });
				window.dispatchEvent(event);
			}

			function handleClick(e) {
				if (e.currentTarget.getAttribute('aria-selected') === 'true') return;
				const targetId = e.currentTarget.getAttribute('data-sv-tab-target');
				const tab = HAS_PANELS ? root.querySelector(`[data-guid="${targetId}"]`) : root.querySelector(`[data-guid="${targetId}"]`).parentNode;
				handleLoadTab(tab);
				activateTab({ button: e.currentTarget, tab });
			}

			function handleLoadTab(tab) {
				if (
					!tab.hasAttribute('data-loaded') &&
						tab.dataset?.content
				) {
					const component = decodeURIComponent(tab.dataset.content);
					const range = document.createRange();
					const content = range.createContextualFragment(component);
					tab.setAttribute('data-loaded', true);
					tab.appendChild(content);
					delete tab.dataset.content;
				}
			}

			function handleKeydown(e) {
				const currentId = e.currentTarget.getAttribute('data-sv-tab-target');
				const currentIndex = data.findIndex(({ guid }) => guid === currentId);
				let nextIndex;

				switch (e.key) {
					case 'ArrowUp':
						nextIndex = currentIndex - 1;
						if (nextIndex < 0) nextIndex = data.length - 1;
						break;
					case 'ArrowDown':
						nextIndex = currentIndex + 1;
						if (nextIndex == data.length) nextIndex = 0;
						break;
					case 'ArrowLeft':
						nextIndex = currentIndex - 1;
						if (nextIndex < 0) nextIndex = data.length - 1;
						break;
					case 'ArrowRight':
						nextIndex = currentIndex + 1;
						if (nextIndex == data.length) nextIndex = 0;
						break;
					case 'Home':
						nextIndex = 0;
						break;
					case 'End':
						nextIndex = data.length - 1;
						break;
					default:
						break;
				}

				if (nextIndex !== undefined) {
					const nextId = data[+nextIndex].guid;
					const tab = HAS_PANELS ? root.querySelector(`[data-guid="${nextId}"]`) : root.querySelector(`[data-guid="${nextId}"]`).parentNode;
					const button = root.querySelector(`[data-sv-tab-target="${nextId}"]`);
					button.focus();
					activateTab({ button, tab });
				}
			}

			// Init Tabs
			if (HAS_PANELS) {
				Array.from(tabs)[0].classList.add('active');
			} else {
				root.querySelector('.tab-outer > div.contentRender:nth-child(1)').classList.add('active');;
			}

			let html = goatee.fill(tabButton, { data });
			tabEl.innerHTML = html;

			tabEl.querySelectorAll('li > button').forEach(item => {
				item.addEventListener('click', handleClick);
				item.addEventListener('keydown', handleKeydown);
			})
			const firstTab = root.querySelector(".first-tab-button");
			const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
							if (entry.isIntersecting && !entry.target.getAttribute('data-load-handled')) {
								entry.target.setAttribute('data-load-handled', true);
								const buttonEl = entry.target.querySelector('button');
								const targetId = buttonEl.getAttribute('data-sv-tab-target');
								const tab = HAS_PANELS ? root.querySelector(`[data-guid="${targetId}"]`) : root.querySelector(`[data-guid="${targetId}"]`).parentNode;
								handleLoadTab(tab);
								activateTab({ button: buttonEl, tab });
							}
					});
				}, {
				rootMargin: '250px 0px 250px 0px'
			});
			observer.observe(firstTab);
		}
	});
</script></div><div data-civid="67dc4fb9272e07c464965c76" class="contentRender contentRender_36 contentRender_type_widget contentRender_name_plugins_collections_type_custom_faq_question contentRender_name_plugins_collections_template_custom_faqs" data-sv-time="432" data-sv-index="36" data-gtm-vars='{ "tCore" : { "contentNum" : "1" } }'>









<section 
	class="core-faqs expandable core-styles"
	data-guid="23a9a489-e323-4bdb-a501-519b3dc8b415"
	data-js="plugins_collections_custom_faqs"
	style="opacity: 0;"
>
	
		
			<h2 class="faq-title">Things to Do in Orlando FAQs</h2>
		
		
	
	
	<div class="faqs-container" data-accordion>
		
		
		
			<div class="single-col">
				
					
	
	<li id="67d81b61272e07c464938dcc_1" class="accordion-item faq-item" data-accordion-item data-sem-label="Is there anything fun to do in Orlando?">
		<button class="accordion-title question" data-accordion-title data-sem-faq="toggle" data-sem-text="Is there anything fun to do in Orlando?">
			<p>Is there anything fun to do in Orlando?</p>
		</button>

		<div class="accordion-content answer" data-tab-content aria-hidden="true">
			<div class="inner">
				<p>Yes, starting with our world-famous theme parks and continuing through all the other things there are to do here. In fact, it would take more than 121 days to fully enjoy all of Orlando&rsquo;s unforgettable experiences.</p>
				
					<a 
						class="asm-button button-primary button-filled button-arrow" 
						href="https://www.visitorlando.com/blog/" 
						target="_blank" 
						aria-label="Is there anything fun to do in Orlando? Explore - (opens in new tab)"
						data-sem-faq="answer link" 
						data-sem-text="Explore" 
						data-sem-link="https://www.visitorlando.com/blog/"
					>
						
							Explore
						
					</a>
				
			</div>
		</div>
	</li>

				
					
	
	<li id="67d81b28272e07c464938d7c_2" class="accordion-item faq-item" data-accordion-item data-sem-label="Is there anything to do in Orlando besides theme parks?">
		<button class="accordion-title question" data-accordion-title data-sem-faq="toggle" data-sem-text="Is there anything to do in Orlando besides theme parks?">
			<p>Is there anything to do in Orlando besides theme parks?</p>
		</button>

		<div class="accordion-content answer" data-tab-content aria-hidden="true">
			<div class="inner">
				<p>Yes. In addition to standalone attractions, you can enjoy award-winning dining, world-class arts, authentic neighborhoods, outdoor adventures for all ages and interests, live sports, concerts, nightlife, and much more in Orlando.</p>
				
					<a 
						class="asm-button button-primary button-filled button-arrow" 
						href="https://www.visitorlando.com/things-to-do/beyond-theme-parks/" 
						target="_blank" 
						aria-label="Is there anything to do in Orlando besides theme parks? Explore - (opens in new tab)"
						data-sem-faq="answer link" 
						data-sem-text="Explore" 
						data-sem-link="https://www.visitorlando.com/things-to-do/beyond-theme-parks/"
					>
						
							Explore
						
					</a>
				
			</div>
		</div>
	</li>

				
					
	
	<li id="67d81bc0272e07c464938e3a_3" class="accordion-item faq-item" data-accordion-item data-sem-label="What to do in Orlando for two days?">
		<button class="accordion-title question" data-accordion-title data-sem-faq="toggle" data-sem-text="What to do in Orlando for two days?">
			<p>What to do in Orlando for two days?</p>
		</button>

		<div class="accordion-content answer" data-tab-content aria-hidden="true">
			<div class="inner">
				<p>Two days in Orlando is plenty of time to enjoy a theme park or two. Fill out your itinerary with acclaimed dining, live music and performing arts, professional sports, neighborhood exploration and more.</p>
				
			</div>
		</div>
	</li>

				
					
	
	<li id="67d470bf272e07c46491a698_4" class="accordion-item faq-item" data-accordion-item data-sem-label="How to spend three hours in Orlando?">
		<button class="accordion-title question" data-accordion-title data-sem-faq="toggle" data-sem-text="How to spend three hours in Orlando?">
			<p>How to spend three hours in Orlando?</p>
		</button>

		<div class="accordion-content answer" data-tab-content aria-hidden="true">
			<div class="inner">
				<p>Orlando&rsquo;s standalone attractions, including our acclaimed museums and galleries, are perfect for filling a few hours. Most are in our International Drive Entertainment District (I-Drive), but you will find more throughout the destination.</p>
				
					<a 
						class="asm-button button-primary button-filled button-arrow" 
						href="https://www.visitorlando.com/blog/post/orlando-attractions-beyond-theme-parks/" 
						target="_blank" 
						aria-label="How to spend three hours in Orlando? Explore - (opens in new tab)"
						data-sem-faq="answer link" 
						data-sem-text="Explore" 
						data-sem-link="https://www.visitorlando.com/blog/post/orlando-attractions-beyond-theme-parks/"
					>
						
							Explore
						
					</a>
				
			</div>
		</div>
	</li>

				
					
	
	<li id="67d47189272e07c46491a6fa_5" class="accordion-item faq-item" data-accordion-item data-sem-label="What to do in Orlando on a budget?">
		<button class="accordion-title question" data-accordion-title data-sem-faq="toggle" data-sem-text="What to do in Orlando on a budget?">
			<p>What to do in Orlando on a budget?</p>
		</button>

		<div class="accordion-content answer" data-tab-content aria-hidden="true">
			<div class="inner">
				<p>Orlando has things to do for any budget, including <a data-sv-linklookup-id="664e9f9a7f638f2a6a93a035" data-sv-linklookup-type="plugins_nav_navitem_primary_main" data-sv-targetauto="true" href="https://www.visitorlando.com/things-to-do/free-things-to-do/" target="_self">free things to do</a> and<a data-sv-linklookup-id="60f1ab249f318974b297c187" data-sv-linklookup-type="plugins_blog_blog_post_leisure_blog" data-sv-targetauto="true" href="https://www.visitorlando.com/blog/post/cheap-things-to-do-orlando/" target="_self"> 30+ things to do for $30</a>&#xA0;or less. You can save even more with <a data-sv-linklookup-id="658361b7d6de633c98264a3f" data-sv-linklookup-type="plugins_nav_navitem_primary_main" data-sv-targetauto="true" href="https://www.visitorlando.com/offers/" target="_self">special offers</a> and <a data-sv-linklookup-id="60c10b47a5dc9751c4c126f8" data-sv-linklookup-type="plugins_assets_link" data-sv-targetauto="true" href="https://www.bestoforlando.com/" target="_blank">authorized discount theme park and attraction tickets</a> from Visit Orlando powered by BestofOrlando.com.</p>
				
			</div>
		</div>
	</li>

				
					
	
	<li id="67d471cb272e07c46491a727_6" class="accordion-item faq-item" data-accordion-item data-sem-label="What is Orlando best known for?">
		<button class="accordion-title question" data-accordion-title data-sem-faq="toggle" data-sem-text="What is Orlando best known for?">
			<p>What is Orlando best known for?</p>
		</button>

		<div class="accordion-content answer" data-tab-content aria-hidden="true">
			<div class="inner">
				<p>As the Theme Park Capital of the World, Orlando is best known for its theme parks. However, it is also a go-to destination for culinary tourism, outdoor adventures, concerts, live sports, vibrant arts and much more &mdash; not to mention year-round sunny skies.</p>
				
			</div>
		</div>
	</li>

				
			</div>
		
	</div>
</section>

