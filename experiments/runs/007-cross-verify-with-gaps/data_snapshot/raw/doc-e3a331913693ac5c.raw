	], function(collectionHelper, Glide, $, dtn, goatee, asyncLib, stringLib, tripbuilder) {
		const root = document.querySelector('[data-guid="4ba7916d-f3e2-4fbe-b8b9-ad298579912b"]');
		root.classList.add('js-loaded');

		collectionHelper.init({ root : root, slide: '.slide', lazyLoad: true }, function() {
			const itemsTemplate = $("[data-guid=4ba7916d-f3e2-4fbe-b8b9-ad298579912b]").find('[data-sv-items-template]').html();
			const itemsContainer = $("[data-guid=4ba7916d-f3e2-4fbe-b8b9-ad298579912b]").find('[data-sv-items-container]');
			const items = [{"recid":31150,"title":"Hoop-Dee-Doo Musical Revue","primary_category":{"primary":true,"subcatid":2849,"subcatname":"Dinner Theaters & Entertainment","catname":"Attractions","catid":479},"region":"Disney/Lake Buena Vista","city":"Lake Buena Vista","state":"FL","acctid":3836,"rankname":"Standard","link":{"url":"/listing/hoop-dee-doo-musical-revue/31150/"},"description":"A hilarious, high-spirited hootenanny the whole family will enjoy, accompanied by a finger-lickin’ countrified feast. As this experience is quite popular, arrive 30 minutes before the doors open at 4:00 PM, 6:15 PM or 8:30 PM. Seating will begin immediately at these times, and the show begins 20 minutes later. Advance reservations are highly recommended and can be made up to 180 days prior to your visit. For wheelchair-accessible seating, please call to book.","address":"4510 North Fort Wilderness Trail","phone":"407-939-DINE (3463)","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/y5h8lldi0m/jpeg/3836-Hoop-Dee-DooMusicalRevue-2026.jpg?crop=false&position=c&q=80&color=ffffffff&u=4159p7"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Hoop-Dee-Doo Musical Revue | Lake Buena Vista, FL | 31150"},{"recid":31222,"title":"Medieval Times Dinner & Tournament","primary_category":{"primary":true,"subcatid":2849,"subcatname":"Dinner Theaters & Entertainment","catname":"Attractions","catid":479},"region":"Kissimmee/South Orlando","city":"Kissimmee","state":"FL","acctid":5168,"rankname":"Featured","link":{"url":"/listing/medieval-times-dinner-%26-tournament/31222/"},"description":"Step into a world of epic battles and royal feasts at Medieval Times, now featuring an all-new show! Kingdoms come together to celebrate their alliance and a new era of peace, but whispers of betrayal stir in the air. Six valiant knights compete in intense sword fights and daring jousts to become the defender of the realm, and your noble house will play a role in cheering your champion to victory! Find your place in the Grand Ceremonial Arena, where each section aligns with the colors of your knight’s kingdom—and your own noble house, of course. As you cheer for your knight, enjoy a four-course feast fit for royalty, served by attentive serfs and wenches. This is medieval dining in its purest form, complete with pre-silverware etiquette. Throughout the evening, marvel at the graceful horsemanship and stunning dressage of our majestic Andalusian horses, and look to the skies as the royal falcon takes flight—a breathtaking sight not to be missed. Are you ready for an epic ‘knight’ out like no other? Don’t miss the chance to experience our new show—it’s an experience that’s fit for royalty!","address":"4510 West Vine Street","phone":"1+ (407) 396-2900","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/iic4qrewyf/jpeg/5168-knights-entering.jpg?crop=false&position=c&q=80&color=ffffffff&u=kggsuk"}},"translated_locales":[],"featuredItem":true,"memberInfo":"Medieval Times Dinner & Tournament | Kissimmee, FL | 31222"},{"recid":50677,"title":"Bond Lounge & Exhibit at Dezerland Park Orlando","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"Universal Area","city":"Orlando","state":"FL","acctid":197085,"rankname":"Standard","link":{"url":"/listing/bond-lounge-%26-exhibit-at-dezerland-park-orlando/50677/"},"description":"Sit down restaurant with a killer menu and the largest collection of Bond memorabilia is at Dezerland Park Orlando in the auto experience with vehicles and items from Sean Connery's era to Daniel Craig's era.","address":"5250 International Drive","phone":"(321) 754-1700","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/78gxnzbhhi/jpeg/197085-bond-lounge.jpg?crop=false&position=c&q=80&color=ffffffff&u=c4dqed"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Bond Lounge & Exhibit at Dezerland Park Orlando | Orlando, FL | 50677"},{"recid":55368,"title":"Lake Fairview Marina","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"Downtown Area","city":"Orlando","state":"FL","acctid":201337,"rankname":"Standard","link":{"url":"/listing/lake-fairview-marina/55368/"},"description":"Welcome to Lake Fairview Marina! At Lake Fairview Marina, we make it easy to enjoy the best Florida has to offer &#8211; sun, water, and fun! Our team offers boat lessons and pontoon boat rentals, sailing lessons and rentals, kayaks, paddleboards and more. For the boater at heart, we offer secured storage, boat and trailer repairs, a ship store and much more. Located in Orlando we are a short drive from either coast, which makes us a perfect centralized location for all your boating needs. So, make the investment into boating with Orlando's friendliest Marina and boat dealers, Lake Fairview Marina! We offer 15% discount for Military and first responders!","address":"4503 N Orange Blossom Trail","phone":"﻿(407) 295-0117","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/ir7fvgc6qn/jpeg/201337-lake1.jpg?crop=false&position=c&q=80&color=ffffffff&u=c4dqed"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Lake Fairview Marina | Orlando, FL | 55368"},{"recid":45559,"title":"Universal Volcano Bay","primary_category":{"primary":true,"subcatid":2858,"subcatname":"Water Parks","catname":"Attractions","catid":479},"region":"Universal Area","city":"Orlando","state":"FL","acctid":182359,"rankname":"Standard","link":{"url":"/listing/universal-volcano-bay/45559/"},"description":"A spectacular volcano towering over a sun swept beach. Swaying palm trees lining your path through a picturesque island escape. It’s a South Seas oasis right in the heart of Universal. From thrilling water slides to secluded waterfalls, Volcano Bay is a water theme park like no other. We’ve taken care of the lines so you don’t have to worry about them. The park’s Virtual Line™ means you have the freedom to spend more time with your family, doing the things you want to do instead of spending all day standing in lines. Volcano Bay is the perfect place to get away from it all, a beach paradise you can enjoy without ever leaving Orlando. Just steps away from our other theme parks, Universal Islands of Adventure and Universal Studios Florida, on-site hotels and the dining, shopping and entertainment of Universal CityWalk.","address":"6000 Universal Boulevard","phone":"(407) 363-8000","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/hdpzi5zpxa/original/182359-waturi-beach-overview.jpg?position=c&crop=yes&color=ffffff&quality=8"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Universal Volcano Bay | Orlando, FL | 45559"},{"recid":53025,"title":"Orlando Haunts","primary_category":{"primary":true,"subcatid":2853,"subcatname":"Sightseeing Tours","catname":"Attractions","catid":479},"region":"Downtown Area","city":"Orlando","state":"FL","acctid":201088,"rankname":"Standard","link":{"url":"/listing/orlando-haunts/53025/"},"description":"Orlando's Best Kept Secret! Our stories are based on historical events, local legends, and eyewitness accounts of paranormal activity across Orlando’s downtown area. We’ve conducted extensive research on each of the stops on our tour for evidence of hauntings and spirits, and we strive to bring you the most accurate and up-to-date information about Orlando’s rich past and paranormal activity. Through tales of death we bring Orlando's history to life. Our dedicated team of guides are there to ensure every tour is gripping and memorable. Book your tour today to experience all the thrills, chills, and fun Orlando has to offer!","phone":"(816) 722-7363","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/7elwba9ccf/jpeg/201088-ghost-tour1.jpg?crop=false&position=c&q=80&color=ffffffff&u=c4dqed"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Orlando Haunts | Orlando, FL | 53025"},{"recid":56009,"title":"The Orlando Eye","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"I-Drive/Convention Area/SeaWorld","city":"Orlando","state":"FL","acctid":172099,"rankname":"Standard","link":{"url":"/listing/the-orlando-eye/56009/"},"description":"Soar above Orlando like never before on The Orlando Eye by Merlin Entertainments! Experience breathtaking 360° views of Orlando from 400 feet in the air and see the City Beautiful from a whole new perspective. Fly to new heights on this EYE-conic Orlando landmark in one of the 30 air-conditioned capsules and take in incredible views of your favorite theme parks, attractions, downtown Orlando, and even Kennedy Space Center! By night, The Orlando Eye is illuminated with dynamic light displays, making it a dazzling focal point of the Orlando skyline. Elevate your flight even further with a stop at The Sky Bar for a glass of beer, wine or champagne before you embark on your journey! Perfect for a special occasion or luxurious treat, The Sky Bar at The Orlando Eye offers drink packages to create unforgettable date nights or group celebrations. Learn how to book your visit at TheOrlandoEye.com","address":"8375 International Drive","phone":"1+ (407) 601-7907","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/zgnpskufsp/jpeg/172099-TheOrlandoEye-2028-7.jpg?crop=false&position=c&q=80&color=ffffffff&u=4159p7"}},"translated_locales":[],"featuredItem":false,"memberInfo":"The Orlando Eye | Orlando, FL | 56009"},{"recid":50658,"title":"Arcade Orlando at Dezerland Park Orlando","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"Universal Area","city":"Orlando","state":"FL","acctid":200411,"rankname":"Standard","link":{"url":"/listing/arcade-orlando-at-dezerland-park-orlando/50658/"},"description":"Home to over 300 Redemption, Skill, Rhythm, Nostalgia, Toddler Riding Games and Video Games. One of Florida's LARGEST Arcades!","address":"5250 International Drive","phone":"(321) 754-1700","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/cg9rpyajgu/jpeg/201465-201465ToxicBlastatDezerlandParkOrlando-2028.jpg?crop=false&position=c&q=80&color=ffffffff&u=p729mb"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Arcade Orlando at Dezerland Park Orlando | Orlando, FL | 50658"},{"recid":44518,"title":"Andretti Indoor Karting & Games","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"I-Drive/Convention Area/SeaWorld","city":"Orlando","state":"FL","acctid":178523,"rankname":"Standard","link":{"url":"/listing/andretti-indoor-karting-%26-games/44518/"},"description":"Health &amp; Safety Information Our 100,000+ sq ft facility features several exciting attractions all under one roof including high-speed electric Superkarts on 2 3-level tracks with multiple elevation changes and semi-oval banked turns, state of the art arcade, racing simulators, two-level laser tag arena, boutique bowling, 7D Xperience Dark Ride motion theater and fully immersive VR experiences! Get fueled up and back on the go in the Andretti Grill offering made from scratch American favorites as well as housemade pizzas and calzones cooked in our brick pizza oven. You can also catch all your favorite games at our Main Bar or Sky bar serving up local craft beer and specialty cocktails. With over 6,000 sq ft of event space, in-house catering, comprehensive A/V and free WiFi, Andretti is the perfect venue for your next party or event. Our experienced associates specialize in a wide variety of private, corporate &amp; social events, small or large. Planners can sit back and relax as our staff is there from beginning to end greeting, guiding and attending to their guests’ every need. Take your entertainment to the next level now at Andretti Indoor Karting and Games!","address":"9299 Universal Boulevard","phone":"(407) 641-0415","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/2uyi9kfvxb/original/178523-racing.jpg?position=c&crop=yes&color=ffffff&quality=8"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Andretti Indoor Karting & Games | Orlando, FL | 44518"},{"recid":31280,"title":"Pirate's Cove Adventure Golf - International Drive","primary_category":{"primary":true,"subcatid":2851,"subcatname":"Miniature Golf","catname":"Attractions","catid":479},"region":"I-Drive/Convention Area/SeaWorld","city":"Orlando","state":"FL","acctid":6229,"rankname":"Standard","link":{"url":"/listing/pirates-cove-adventure-golf-international-drive/31280/"},"description":"Come aboard mates! Make us part of your Orlando vacation. Voted \"Best in Florida\" by Orlando Magazine, our adventure golf courses are renowned for their innovative hole designs, lush landscaping, and entertaining pirate theming. Check out our NEW pirate ship, as well as other exciting and entertaining course renovations! The adventures and legends of infamous pirates come to life as you enter our world of 18th century buccaneers--sunken ships, cascading waterfalls, dreaded pirate dungeons and lush, tropical vegetation. Our manicured courses are specifically designed to provide maximum enjoyment for kids and adults alike. Discover the fun!","address":"8501 International Drive","phone":"(407) 352-7378","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/6f714epbsk/jpeg/Pirate'sCoveAdventureGolf-InternationalDrive-2028-2.jpg?crop=false&position=c&q=80&color=ffffffff&u=4159p7"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Pirate's Cove Adventure Golf - International Drive | Orlando, FL | 31280"},{"recid":31106,"title":"Fun Spot America Theme Parks Orlando","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"Universal Area","city":"Orlando","state":"FL","acctid":3220,"rankname":"Featured","link":{"url":"/listing/fun-spot-america-theme-parks-orlando/31106/"},"description":"Planning your Orlando vacation? Add a day that’s big on thrills, easy on your schedule and built for real value. Fun Spot America is Central Florida’s only family-owned theme park company, with locations in Orlando and Kissimmee. There are no reservations required, no complicated planning and no all-day commitment - just show up and have fun. Admission and parking are always FREE. Pay by the ride or choose an unlimited ride wristband. It’s Orlando fun on your terms. Fun Spot is famous for its multi-level go-kart tracks - the attractions that put the parks on the map. Race on elevated tracks with high-speed turns and thrilling drops that you won’t find anywhere else in Orlando. It’s hands-on excitement the whole family can experience together. Beyond the tracks, you’ll find a full lineup of thrill rides, family attractions and rides for younger kids — plus Orlando’s only wooden roller coasters, White Lightning and Mine Blower. For adrenaline seekers, take flight on one of the tallest SkyCoasters in the world - 300 feet in Kissimmee and 250 feet in Orlando - a heart-pounding experience that combines skydiving and hang gliding. At the Orlando location, don’t miss Gator Spot, a 15,000-square-foot Gatorland experience featuring more than 100 alligators, along with exotic reptiles and birds — a true taste of Florida wildlife without leaving the park. Cool off at the Orlando Splash Pad, enjoy classic midway games and the arcade, or plan a birthday party, reunion or corporate event. When your Orlando itinerary calls for something thrilling, flexible and affordable, Fun Spot America delivers - shorter lines, real coasters, world-class go-karts and zero parking fees. More memories. More value. More smiles. HUGE FUN!!!","address":"5700 Fun Spot Way","phone":"(407) 363-3867","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/rgcy9ourxt/original/3220-ferris-wheel-day.jpeg?position=c&crop=yes&color=ffffff&quality=8"}},"translated_locales":[],"featuredItem":true,"memberInfo":"Fun Spot America Theme Parks Orlando | Orlando, FL | 31106"},{"recid":58632,"title":"Great Big Game Show Orlando","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"I-Drive/Convention Area/SeaWorld","city":"Orlando","state":"FL","acctid":201747,"rankname":"Featured","link":{"url":"/listing/great-big-game-show-orlando/58632/"},"description":"Ever wanted to try being on a game show? Here's your chance! Great Big Game Show is an immersive game show experience. Two teams will face off in a battle for points and glory. Each round of Great Big Game Show features 5+ mini-games. Our line-up of rotating mini-games includes strategy, trivia, luck, and more! Great Big Game Show Orlando is located in a vibrant lifestyle center surrounded by dining and entertainment. Grab a bite at Mango’s &#8211; Orlando, LongHorn Steakhouse or toast your win with wine and dinner at Cooper’s Hawk Winery & Restaurant. Parking is available in the lot behind our location, with access from the intersection of International Drive and Jamaican Ct. Address: 8145 International Drive #511 Orlando, FL 32819 Questions? Contact us at Hello@GreatBigGameShow.com or 321-320-8617.","address":"8145 International Dr.","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/znwgxfwmnd/png/201747-GreatBigGameShowOrlando-2029-4.png?crop=false&position=c&color=ffffffff&u=kggsuk"}},"translated_locales":[],"featuredItem":true,"memberInfo":"Great Big Game Show Orlando | Orlando, FL | 58632"},{"recid":37079,"title":"Kings Dining & Entertainment","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"I-Drive/Convention Area/SeaWorld","city":"Orlando","state":"FL","acctid":162658,"rankname":"Standard","link":{"url":"/listing/kings-dining-%26-entertainment/37079/"},"description":"At Kings you can expect an unparalleled social scene for all occasions; be it a family outing, a date night hotspot, a corporate event or the best place in town to connect with friends. We’re in the business of making great memories and we hope to do just that for you and your group! Full-service, executive chef-driven restaurant serving award-winning food, Features 22 luxury Ten Pin Bowling Lanes, Four full-size billiards tables, & numerous table games Over 60 giant HDTV’s and HD projector screens, Industry best sound, lighting and music environment Two premium bars serving fun and innovative cocktails Customizable private space for parties of 10-500 people A Retrocade that has old school, nostalgic gaming with a modern twist. Regulation Shuffleboard table and Outdoor Bocce Ball Court Two Patio spaces","address":"8255 South International Drive Suite 120","phone":"(407) 363-0200","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/naaj1f4dcp/original/162658-bowling.jpg?position=c&crop=yes&color=ffffff&quality=8"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Kings Dining & Entertainment | Orlando, FL | 37079"},{"recid":58610,"title":"Sky Zone Orlando","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"Downtown Area","city":"Orlando","state":"FL","acctid":201745,"rankname":"Standard","link":{"url":"/listing/sky-zone-orlando/58610/"},"description":"Jumping, soaring, unforgettable parties and fun like you’ve never experienced at a trampoline park before.","address":"8010 W Colonial Drive","phone":"(407) 307-3700","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/feoxkimv9e/jpeg/SkyzoneOrlando-2029-4.jpg?crop=false&position=c&q=80&color=ffffffff&u=4159p7"}},"translated_locales":[],"featuredItem":false,"memberInfo":"Sky Zone Orlando | Orlando, FL | 58610"},{"recid":58407,"title":"iFLY Orlando Indoor Skydiving","primary_category":{"primary":true,"subcatid":2852,"subcatname":"Popular Attractions","catname":"Attractions","catid":479},"region":"I-Drive/Convention Area/SeaWorld","city":"Orlando","state":"FL","acctid":133664,"rankname":"Standard","link":{"url":"/listing/ifly-orlando-indoor-skydiving/58407/"},"description":"iFLY Orlando can accommodate groups 1-60 people. We offer experiences from flight only to full events, including meetings, food & beverage, facility buy outs and more. Please reach out to our National Sales Manager, Manda Mazzuca Richards, at mmazzuca@iflyworld.com for more details, pricing, and availability.","address":"8969 International Drive","phone":"1+ (407) 337-4359 Ext. 1110","asset":{"type":"image","resource":{"imageUrl":"https://visitorlando.widen.net/content/rx7utvahcn/jpeg/iFLYOrlandoIndoorSkydiving-2029-2035.jpg?crop=false&position=c&q=80&color=ffffffff&u=4159p7"}},"translated_locales":[],"featuredItem":false,"memberInfo":"iFLY Orlando Indoor Skydiving | Orlando, FL | 58407"}];
