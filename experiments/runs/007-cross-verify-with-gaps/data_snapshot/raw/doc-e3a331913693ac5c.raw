	style="opacity: 1;"
>
	
		

	<div class="inner center h2 ">

		<div class="title-cont">
			
				 
					<h2 class="title h2"> 
						Go Beyond the Theme Parks 
					</h2>
				
			
			
				<p class="description">
					Sure, Orlando is the Theme Park Capital of the World. But the parks are just the start of everything our vibrant, welcoming destination has to offer.
				</p>
			
			
		</div>
	</div>

	
</section>

<script>
	require([], function() {
		const root = 
			document.querySelector('[data-guid="89c64066-a1f1-4622-9ac7-b957ca79890f"]');
		const comboPanelStyle = root.closest('[data-combo-panel-style]');
		if (comboPanelStyle) {
			const button = root.querySelector('.mindtrip-form button');
			if (button) {
				if (
					comboPanelStyle.dataset.comboPanelStyle === 'variant_one' ||
						comboPanelStyle.dataset.comboPanelStyle === 'variant_two' ||
							comboPanelStyle.dataset.comboPanelStyle === 'variant_three'
				) {
					button.classList.add('blue-to-white');
				} else if(
					comboPanelStyle.dataset.comboPanelStyle === 'default'
				) {
					button.classList.add('white-to-blue');
				}
			}
		}
	});
</script></div><div data-civid="6a74f10b64a4f090739584d2" class="contentRender contentRender_14 contentRender_type_widget contentRender_name_plugins_collections_type_custom_slides contentRender_name_plugins_collections_template_custom_mosaic_grid" data-sv-time="453" data-sv-index="14" data-gtm-vars='{ "tCore" : { "contentNum" : "3" } }'>









