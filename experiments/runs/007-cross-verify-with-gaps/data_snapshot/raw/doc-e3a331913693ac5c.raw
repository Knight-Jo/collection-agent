const%20root%20%3D%20document.querySelector(%27%5Bdata-guid%3D%22f6a5e1e4-281d-4dbe-a693-d99035079a11%22%5D%27)%3B%0D%0A%09%09const%20childTabs%20%3D%20Array.from(root.querySelectorAll(%27%5Bdata-accordion%5D%20%5Bdata-accordion-item%5D%27))%3B%0D%0A%09%09const%20tabContentEl%20%3D%20root.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%09%09const%20cs%20%3D%20tabContentEl%20%3F%20getComputedStyle(tabContentEl)%20%3A%20null%3B%0D%0A%09%09const%20drawerTransitionDuration%20%3D%20parseFloat(cs%20%26%26%20cs.getPropertyValue(%27transition-duration%27))%20*%201000%3B%0D%0A%09%09const%20resizeEvents%20%3D%20%5B%27resize%27%2C%20%27orientationchange%27%5D%3B%0D%0A%09%09const%20focusableQuery%20%3D%20%27a%2C%20area%2C%20button%2C%20input%2C%20object%2C%20select%2C%20textarea%2C%20%5Btabindex%5D%27%3B%0D%0A%0D%0A%09%09function%20open(el)%20%7B%0D%0A%09%09%09const%20parent%20%3D%20el.parentElement%3B%0D%0A%09%09%09const%20panel%20%3D%20parent.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%09%09%09const%20maxHeight%20%3D%20%60%24%7Bpanel.scrollHeight%7Dpx%60%3B%0D%0A%09%09%09const%20asset%20%3D%20root.querySelector(%60%5Bdata-asset%3D%22%24%7Bel.parentNode.dataset.assetId%7D%22%5D%60)%3B%0D%0A%0D%0A%09%09%09parent.classList.add(%27active%27)%3B%0D%0A%09%09%09asset.classList.add(%27active%27)%3B%0D%0A%0D%0A%09%09%09el.setAttribute(%27open%27%2C%20true)%3B%0D%0A%09%09%09el.setAttribute(%27aria-expanded%27%2C%20true)%3B%0D%0A%0D%0A%09%09%09panel.setAttribute(%27aria-hidden%27%2C%20false)%3B%0D%0A%09%09%09panel.style.maxHeight%20%3D%20maxHeight%3B%0D%0A%09%09%09panel.querySelectorAll(focusableQuery).forEach(el%20%3D%3E%20el.setAttribute(%27tabindex%27%2C%200))%0D%0A%09%09%7D%0D%0A%0D%0A%09%09function%20close(el%2C%20sameNode)%20%7B%0D%0A%09%09%09const%20parent%20%3D%20el.parentElement%3B%0D%0A%09%09%09const%20panel%20%3D%20parent.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%09%09%09const%20asset%20%3D%20root.querySelector(%60%5Bdata-asset%3D%22%24%7Bel.parentNode.dataset.assetId%7D%22%5D%60)%3B%0D%0A%09%09%09const%20activeAsset%20%3D%20root.querySelector(%60%5Bdata-asset%5D.active%60)%3B%0D%0A%0D%0A%09%09%09parent.classList.remove(%27active%27)%3B%0D%0A%09%09%09%2F%2F%20Keeps%20the%20asset%20active%20when%20the%20corresponding%20accordion%20is%20closed%0D%0A%09%09%09if%20(sameNode)%20%7B%0D%0A%09%09%09%7D%20else%20%7B%0D%0A%09%09%09%09activeAsset.classList.remove(%27active%27)%3B%0D%0A%09%09%09%7D%0D%0A%0D%0A%09%09%09el.removeAttribute(%27open%27)%3B%0D%0A%09%09%09el.setAttribute(%27aria-expanded%27%2C%20false)%3B%0D%0A%0D%0A%09%09%09panel.setAttribute(%27aria-hidden%27%2C%20true)%3B%0D%0A%09%09%09panel.style.maxHeight%20%3D%20%27%27%3B%0D%0A%09%09%09panel.querySelectorAll(focusableQuery).forEach(el%20%3D%3E%20el.setAttribute(%27tabindex%27%2C%20-1))%3B%0D%0A%09%09%7D%0D%0A%0D%0A%09%09function%20resizeFn()%20%7B%0D%0A%09%09%09const%20openTabs%20%3D%20childTabs.filter(tab%20%3D%3E%20tab.classList.contains(%27active%27))%3B%0D%0A%0D%0A%09%09%09if%20(!openTabs%20%7C%7C%20!openTabs.length)%20return%3B%0D%0A%0D%0A%09%09%09openTabs.forEach(tab%20%3D%3E%20%7B%0D%0A%09%09%09%09const%20tabContent%20%3D%20tab.querySelector(%27%5Bdata-tab-content%5D%27)%3B%0D%0A%0D%0A%09%09%09%09tabContent.style.maxHeight%20%3D%20%60%24%7BtabContent.scrollHeight%7Dpx%60%3B%0D%0A%09%09%09%7D)%3B%0D%0A%09%09%7D%0D%0A%0D%0A%09%09%2F%2F%20--------%20INIT%20---------%20%2F%2F%0D%0A%09%09root.querySelectorAll(%60%5Bdata-tab-content%5D%20%3Ais(%24%7BfocusableQuery%7D%60).forEach(el%20%3D%3E%20el.setAttribute(%27tabindex%27%2C%20-1))%0D%0A%0D%0A%09%09%2F%2F%20Opens%20the%20first%20accordion%20by%20default%20on%20page%20load%0D%0A%09%09root.querySelectorAll(%27%5Bdata-accordion-title%5D%27).forEach(node%20%3D%3E%20%7B%0D%0A%09%09%09if%20(node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09open(node)%3B%0D%0A%09%09%09%7D%20return%3B%0D%0A%09%09%7D)%0D%0A%0D%0A%09%09%2F%2F%20Handles%20the%20opening%20and%20closing%20of%20accordion%20tabs%20(only%20one%20can%20be%20opened%20at%20a%20time)%20%0D%0A%09%09root.querySelectorAll(%27%5Bdata-accordion-item%5D%20%5Bdata-accordion-title%5D%27).forEach(node%20%3D%3E%20node.addEventListener(%27click%27%2C%20()%20%3D%3E%20%7B%0D%0A%09%09%09if%20(node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09close(node%2C%20true)%0D%0A%09%09%09%7D%20else%20if%20(root.querySelectorAll(%27%5Bdata-accordion-item%5D.active%27).length%20%3D%3D%3D%200)%20%7B%0D%0A%09%09%09%09close(node%2C%20false)%0D%0A%09%09%09%09open(node)%0D%0A%09%09%09%7D%20else%20if%20(!node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09root.querySelectorAll(%27%5Bdata-accordion-title%5D%27).forEach(node%20%3D%3E%20%7B%0D%0A%09%09%09%09%09if%20(node.parentElement.classList.contains(%27active%27))%20%7B%0D%0A%09%09%09%09%09%09close(node%2C%20false)%3B%0D%0A%09%09%09%09%09%7D%20return%0D%0A%09%09%09%09%7D)%0D%0A%09%09%09%09open(node)%3B%0D%0A%09%09%09%7D%0D%0A%09%09%7D))%3B%0D%0A%0D%0A%09%09%2F%2F%20when%20resizing%20the%20window%2C%20make%20sure%20the%20open%20accordions%20don%27t%20allow%20the%20content%20to%20overflow%0D%0A%09%09resizeEvents.forEach(ev%20%3D%3E%20window.addEventListener(ev%2C%20utils.debounce(resizeFn%2C%20200)))%3B%0D%0A%09%7D)%3B%0D%0A%3C%2Fscript%3E%3C%2Fdiv%3E"
