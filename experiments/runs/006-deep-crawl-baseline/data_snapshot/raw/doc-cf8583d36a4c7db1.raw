    <script>
      document.addEventListener('DOMContentLoaded', function () {
        // 获取VT35按钮和product-compare元素
        const vt35Button = document.getElementById('vt35');
        const eh216Button = document.getElementById('eh216s');
        const productCompare = document.querySelector('.product-compare');

        // 确保元素存在
        if (vt35Button && productCompare) {
          // VT35按钮鼠标移入事件
          vt35Button.addEventListener('mouseenter', function () {
            productCompare.classList.add('left');
            productCompare.classList.remove('right');
          });

          // VT35按钮鼠标移出事件
          vt35Button.addEventListener('mouseleave', function () {
            productCompare.classList.remove('left');
          });
        }

        if (eh216Button && productCompare) {
          // EH216-S按钮鼠标移入事件
          eh216Button.addEventListener('mouseenter', function () {
            productCompare.classList.add('right');
            productCompare.classList.remove('left');
          });

          // EH216-S按钮鼠标移出事件
          eh216Button.addEventListener('mouseleave', function () {
            productCompare.classList.remove('right');
          });
        }
      });
    </script>
  </div>
</body>
</html>