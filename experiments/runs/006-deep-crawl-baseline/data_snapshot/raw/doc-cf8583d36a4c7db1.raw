    <script>

      var mySwiper = new Swiper ('.swiperIndex2', {
        loop: true, // 循环模式选项
        effect: 'fade',
        autoplay: {
          delay: 3000, // 3秒自动切换
          disableOnInteraction: false, // 用户操作后继续自动播放
        },
        // 如果需要分页器
        pagination: {
          el: '.swiper-pagination',
          clickable: true
        },
        navigation: {
          nextEl: '.index-2-button-next',
          prevEl: '.index-2-button-prev',
        }
      })


      
      // 添加自定义分页器的交互功能
        document.addEventListener('DOMContentLoaded', function () {
          // 获取所有自定义分页项
          const customPaginationItems = document.querySelectorAll('.swiper-pagination-custom-item');

          // 为每个分页项添加点击事件
          customPaginationItems.forEach((item, index) => {
            item.addEventListener('mouseenter', function () {
              // 移除所有活动状态
              customPaginationItems.forEach(i => i.classList.remove('active'));

              // 添加当前活动状态
              this.classList.add('active');

              // 切换到对应的slide
              mySwiper.slideToLoop(index);
            });
          });

          // 当swiper切换时，同步更新自定义分页器状态
          if (mySwiper) {
            mySwiper.on('slideChangeTransitionStart', function () {
              const activeIndex = this.realIndex;

              // 移除所有活动状态
              customPaginationItems.forEach(item => item.classList.remove('active'));

              // 添加对应活动状态
              if (customPaginationItems[activeIndex]) {
                customPaginationItems[activeIndex].classList.add('active');
              }
            });
          }
        });

      // 渐变显示出现
      // 监听numberAdd进入窗口
      const targetElements = document.querySelectorAll('.fedeBox');
      let isActive = false
      const observerCallback = (entries, observer) => {
        entries.forEach(entry => {
          const element = entry.target;
          if (entry.isIntersecting) {
            element.classList.add('showFade');
          }
        });
      };
      const observerOptions = { threshold: 1 }; // 可以根据需求调整阈值
      const observer = new IntersectionObserver(observerCallback, observerOptions);   
      targetElements.forEach(element => observer.observe(element));
    </script>
    <script
      type="text/javascript"
