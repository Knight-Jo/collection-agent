<script>
                         function searchOnsubmit() {  
                            if(frm.searchword.value==''){
                                 alert('请输入检索关键字！');

                                 frm.searchword.focus();
                                 return false; 
                         }} 
                         function search() {
                            if(frm.searchword.value=='') { 
                                 alert('请输入检索关键字！'); 
                                 frm.searchword.focus(); 
                                 return false;
                            }
                                 frm.submit(); 
                         } 

// 点击搜索按钮执行提交
function dosearch(){
    let keyword = document.getElementById("searchword").value.trim();
    // 非空校验
    if(keyword === ''){
        alert("请输入搜索内容！");
        return false;
    }
    // 提交表单
    document.getElementById("form1").submit();
}

// 回车触发搜索
function checkInput(){
    if(event.keyCode === 13){
        dosearch();
        return false;
    }
    return true;
}

// 搜索词回填（搜索后保留输入内容）
function getUrlParam(name){
    let reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
    let res = window.location.search.substr(1).match(reg);
    return res ? decodeURIComponent(res[2]) : '';
}
window.onload = function(){
    let word = getUrlParam("searchword");
    document.getElementById("searchword").value = word;
}
</script>



