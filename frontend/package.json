{
  "name": "intel-agent-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "biome format --write ./src ./vite.config.ts",
    "format:check": "biome format ./src ./vite.config.ts",
    "lint": "biome lint ./src ./vite.config.ts",
    "check": "biome check ./src ./vite.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.40.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19",
    "react-dom": "19",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.10"
  }
}
